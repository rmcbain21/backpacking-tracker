@using BackpackingTracker.Core.Trips
@* Picks Meals and Food Items to put in one of a Trip Day's meal slots: search, then tap to add (tapping again adds one
   more), or adds a Placeholder for food not chosen yet. Retired ones aren't offered. With ReplaceEntryId set, it's
   "Replace with…" for that Placeholder instead: tapping a Meal or Food Item swaps it in and closes. *@
@inject AppCore App
@inject ISnackbar Snackbar

<MudDialog ContentClass="add-gear-content">
    <DialogContent>
        @if (ReplaceEntryId is null)
        {
            @PlaceholderForm()
        }
        <MudTextField T="string" @bind-Value="_searchText" Label="Search Meals and food" Immediate="true" DebounceInterval="200"
                      Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />
        @if (_meals is null || _foodItems is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            var meals = _meals.Where(new MealFilter(_searchText).Matches).ToList();
            var foodItems = _foodItems.Where(new FoodFilter(_searchText).Matches).ToList();
            @if (meals.Count == 0 && foodItems.Count == 0)
            {
                <MudText Class="mud-text-secondary">
                    @(string.IsNullOrWhiteSpace(_searchText) ? "No Meals or food yet. Add them on the Food page." : "Nothing matches.")
                </MudText>
            }
            @if (meals.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">Meals</MudText>
                @foreach (var meal in meals)
                {
                    @PickRow(meal.Meal.Name, $"{NutritionInput.Calories(meal.Totals.Calories)} · {UnitFormat.Weight(meal.Totals.WeightGrams, UnitSystem)}",
                             _inSlot.GetValueOrDefault(meal.Meal.Id), () => AddMealAsync(meal.Meal))
                }
            }
            @if (foodItems.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">Food Items</MudText>
                @foreach (var item in foodItems)
                {
                    @PickRow(item.Name, $"{NutritionInput.Calories(item.CaloriesPerServing)} · {UnitFormat.Weight(item.ServingWeightGrams, UnitSystem)} a serving",
                             _inSlot.GetValueOrDefault(item.Id), () => AddFoodItemAsync(item))
                }
            }
        }
    </DialogContent>
    <DialogActions>
        @if (ReplaceEntryId is not null)
        {
            <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => MudDialog.Close()">Done</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string TripId { get; set; } = "";

    [Parameter, EditorRequired]
    public DateOnly Date { get; set; }

    [Parameter, EditorRequired]
    public MealSlot Slot { get; set; }

    /// <summary>The Placeholder to Replace with what's tapped, or null to add to the slot.</summary>
    [Parameter]
    public string? ReplaceEntryId { get; set; }

    private UnitSystem UnitSystem { get; set; }

    private string? _searchText;
    private IReadOnlyList<MealView>? _meals;
    private IReadOnlyList<FoodItem>? _foodItems;

    /// <summary>The quantity of each Meal or Food Item (by id) already in the slot.</summary>
    private Dictionary<string, decimal> _inSlot = [];

    private bool _placeholderOpen;
    private PlaceholderFields _placeholder = new();

    protected override async Task OnInitializedAsync()
    {
        UnitSystem = (await App.Settings.GetAsync()).UnitSystem;
        _placeholder = new PlaceholderFields(UnitSystem);
        _meals = await App.Meals.ListMealsAsync();
        _foodItems = await App.Food.ListFoodItemsAsync();
        await LoadSlotAsync();
    }

    private async Task LoadSlotAsync()
    {
        var day = (await App.Trips.GetTripAsync(TripId))?.Trip.Days.FirstOrDefault(d => d.Date == Date);
        _inSlot = (day?.SlotEntries ?? [])
            .Where(entry => entry.Slot == Slot && !entry.IsPlaceholder)
            .GroupBy(entry => entry.MealId ?? entry.FoodItemId ?? "")
            .ToDictionary(group => group.Key, group => group.Sum(entry => entry.Quantity));
    }

    /// <summary>"Not sure yet? Add a Placeholder", opening a small form: label, estimated calories and weight.</summary>
    private RenderFragment PlaceholderForm() => @<text>
        @if (!_placeholderOpen)
        {
            <div class="d-flex align-center py-2 gap-2 pick-row add-placeholder" role="button" tabindex="0"
                 aria-label="Add a Placeholder" @onclick="() => _placeholderOpen = true">
                <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Primary" />
                <div class="flex-grow-1">
                    <MudText>Placeholder</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Not chosen yet, such as food bought in town</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" />
            </div>
            <MudDivider Class="mb-2" />
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-3 mb-3 placeholder-form">
                <MudText Typo="Typo.subtitle2">Placeholder</MudText>
                <PlaceholderEditor Fields="_placeholder" />
                <div class="d-flex justify-end gap-2 mt-2">
                    <MudButton Size="Size.Small" OnClick="() => _placeholderOpen = false">Cancel</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddPlaceholderAsync"
                               Class="add-placeholder-confirm">Add</MudButton>
                </div>
            </MudPaper>
        }
    </text>;

    private RenderFragment PickRow(string name, string detail, decimal inSlot, Func<Task> add) => @<text>
        <div class="d-flex align-center py-2 gap-2 pick-row" role="button" tabindex="0"
             aria-label="@(ReplaceEntryId is null ? $"Add {name}" : $"Replace with {name}")" @onclick="add">
            <div class="flex-grow-1">
                <MudText>@name</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@detail</MudText>
            </div>
            @if (inSlot > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@(ReplaceEntryId is null ? "Added" : "In slot") @(inSlot == 1m ? "" : $"×{ServingsInput.Format(inSlot)}")</MudChip>
            }
            else
            {
                <MudIcon Icon="@(ReplaceEntryId is null ? Icons.Material.Filled.AddCircleOutline : Icons.Material.Filled.SwapHoriz)" Color="Color.Primary" />
            }
        </div>
        <MudDivider />
    </text>;

    private Task AddMealAsync(Meal meal) => ReplaceEntryId is { } id
        ? ReplaceAsync(() => App.Trips.ReplacePlaceholderWithMealAsync(TripId, Date, id, meal.Id))
        : TryAsync(() => App.Trips.AddMealToSlotAsync(TripId, Date, Slot, meal.Id));

    private Task AddFoodItemAsync(FoodItem item) => ReplaceEntryId is { } id
        ? ReplaceAsync(() => App.Trips.ReplacePlaceholderWithFoodItemAsync(TripId, Date, id, item.Id))
        : TryAsync(() => App.Trips.AddFoodItemToSlotAsync(TripId, Date, Slot, item.Id));

    private async Task AddPlaceholderAsync()
    {
        if (_placeholder.Read() is not { } placeholder)
        {
            return;
        }

        try
        {
            await App.Trips.AddPlaceholderToSlotAsync(TripId, Date, Slot, placeholder);
            Snackbar.Add($"Added {placeholder.NameIn(Slot)}", Severity.Success);
            _placeholderOpen = false;
            _placeholder = new PlaceholderFields(UnitSystem);
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task ReplaceAsync(Func<Task> replace)
    {
        try
        {
            await replace();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task TryAsync(Func<Task> add)
    {
        try
        {
            await add();
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }

        await LoadSlotAsync();
    }
}
