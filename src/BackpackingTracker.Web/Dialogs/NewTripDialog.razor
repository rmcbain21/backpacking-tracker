@using BackpackingTracker.Core.Lists
@* Creates a Trip: a name, start and end dates (or just a start, for an Open-ended Trip), and optionally a Gear List
   to copy as its Packing List. Returns the new Trip's id. A refusal (no name, end before start) is shown here so
   nothing typed is lost. *@
@inject AppCore App

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" AutoFocus="true" Immediate="true" Class="trip-name" />
        <div class="d-flex gap-3">
            <MudDatePicker Date="_start" DateChanged="StartChanged" Label="Start" Class="trip-start" />
            @if (!_openEnded)
            {
                <MudDatePicker @bind-Date="_end" Label="End" Class="trip-end" />
            }
        </div>
        <MudSwitch T="bool" @bind-Value="_openEnded" Color="Color.Primary" Class="mt-2 trip-open-ended"
                   Label="Open-ended: add days as I go" />
        @if (_openEnded)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                For a thru hike with no set finish. The Trip starts with day 1, and you add each day as you hike it.
            </MudText>
        }
        <MudSelect T="string" @bind-Value="_gearListId" Label="Packing List from" Class="trip-gear-list"
                   ToStringFunc="@(id => id is null ? NoGearList : _gearLists.FirstOrDefault(l => l.GearList.Id == id)?.GearList.Name)">
            <MudSelectItem T="string" Value="null">@NoGearList</MudSelectItem>
            @foreach (var view in _gearLists)
            {
                <MudSelectItem T="string" Value="view.GearList.Id">@view.GearList.Name</MudSelectItem>
            }
        </MudSelect>
        @if (_refusal is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@_refusal</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string NoGearList = "Nothing (start empty)";

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The Gear List chosen to start with, if any.</summary>
    [Parameter]
    public string? GearListId { get; set; }

    private string? _name;
    private DateTime? _start;
    private DateTime? _end;
    private bool _openEnded;
    private string? _gearListId;
    private string? _refusal;
    private IReadOnlyList<GearListView> _gearLists = [];

    protected override async Task OnInitializedAsync()
    {
        _gearListId = GearListId;
        _gearLists = await App.Lists.ListGearListsAsync();
    }

    /// <summary>Picking a start moves the end along with it when the end is unset or would come first.</summary>
    private void StartChanged(DateTime? start)
    {
        _start = start;
        if (start is not null && (_end is null || _end < start))
        {
            _end = start;
        }
    }

    private async Task CreateAsync()
    {
        if (_start is null || (_end is null && !_openEnded))
        {
            _refusal = _openEnded ? "Choose the start date." : "Choose the start and end dates.";
            return;
        }

        try
        {
            var start = DateOnly.FromDateTime(_start.Value);
            var end = _openEnded ? start : DateOnly.FromDateTime(_end!.Value);
            var trip = await App.Trips.CreateTripAsync(_name ?? "", start, end, _gearListId, _openEnded);
            MudDialog.Close(DialogResult.Ok(trip.Id));
        }
        catch (RuleViolationException ex)
        {
            _refusal = ex.Message;
        }
    }
}
