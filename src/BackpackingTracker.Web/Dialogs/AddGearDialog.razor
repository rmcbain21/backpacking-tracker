@using BackpackingTracker.Core.Lists
@* Picks Gear Items to add to a Gear List, into the chosen Category: search, then tap to add (tapping again
   adds one more). Retired gear isn't offered. *@
@inject AppCore App
@inject ISnackbar Snackbar

<MudDialog ContentClass="add-gear-content">
    <DialogContent>
        <MudSelect T="string" @bind-Value="_categoryId" Label="Add into Category" Class="add-into-category mb-1">
            @foreach (var category in Categories)
            {
                <MudSelectItem Value="category.Id">@category.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" Value="_searchText" ValueChanged="SearchAsync" Label="Search gear" Immediate="true"
                      DebounceInterval="200" Clearable="true" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />
        @if (_items is { Count: 0 })
        {
            <MudText Class="mud-text-secondary">@(string.IsNullOrWhiteSpace(_searchText) ? "No gear yet." : "No Gear Items match.")</MudText>
        }
        @foreach (var item in _items ?? [])
        {
            <div class="d-flex align-center py-2 gap-2 pick-row" role="button" tabindex="0"
                 aria-label="@($"Add {item.Name}")" @onclick="() => AddAsync(item)">
                <div class="flex-grow-1">
                    <MudText>@item.Name</MudText>
                    @if (item.GearType.Length > 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@item.GearType</MudText>
                    }
                </div>
                @if (_onList.TryGetValue(item.Id, out var quantity))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">On list @(quantity > 1 ? $"×{quantity}" : "")</MudChip>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" />
                }
            </div>
            <MudDivider />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => MudDialog.Close()">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string GearListId { get; set; } = "";

    /// <summary>The list's Categories, for the dropdown.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Category> Categories { get; set; } = [];

    /// <summary>The Category the dropdown starts on.</summary>
    [Parameter, EditorRequired]
    public string CategoryId { get; set; } = "";

    private string _categoryId = "";
    private string? _searchText;
    private IReadOnlyList<GearItem>? _items;

    // How many of each Gear Item the list holds, so gear already on it is marked.
    private Dictionary<string, int> _onList = [];

    protected override async Task OnInitializedAsync()
    {
        _categoryId = CategoryId;
        await LoadAsync();
        await LoadListAsync();
    }

    private async Task LoadListAsync()
    {
        var list = await App.Lists.GetGearListAsync(GearListId);
        _onList = (list?.Entries ?? [])
            .GroupBy(entry => entry.Entry.GearItemId)
            .ToDictionary(group => group.Key, group => group.Sum(entry => entry.Entry.Quantity));
    }

    private async Task LoadAsync() =>
        _items = await App.Gear.ListGearItemsAsync(new GearFilter(_searchText));

    private async Task SearchAsync(string? searchText)
    {
        _searchText = searchText;
        await LoadAsync();
    }

    private async Task AddAsync(GearItem item)
    {
        try
        {
            await App.Lists.AddEntryAsync(GearListId, item.Id, _categoryId);
            await LoadListAsync();
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }
}
