@using BackpackingTracker.Core.Trips
@* Changes how many of a Meal (or servings of a Food Item) a meal slot has, or takes it out of the slot. On a
   Placeholder, also its label and estimates, and "Replace with…", which closes with ReplaceResult so the page can
   open the picker. *@
@inject AppCore App

<MudDialog>
    <DialogContent>
        @if (ServingsPerPackage is { } perPackage)
        {
            <MudToggleGroup T="bool" Value="_byPackage" ValueChanged="SwitchUnit" Color="Color.Primary" Size="Size.Small" Class="mb-1 amount-unit">
                <MudToggleItem Value="false" Text="Servings" />
                <MudToggleItem Value="true" Text="Packages" />
            </MudToggleGroup>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@ServingsInput.Servings(perPackage) a package</MudText>
        }
        <MudTextField @bind-Value="_quantityText" Label="@(Entry.FoodItemId is null ? "How many" : _byPackage ? "Packages" : "Servings")" InputMode="@(InputMode.@decimal)"
                      Immediate="true" Validation="@(new Func<string?, string?>(text => ServingsInput.Parse(text).Error))" Class="slot-quantity"
                      HelperText="@AmountHelp" />
        @if (_placeholder is not null)
        {
            <PlaceholderEditor Fields="_placeholder" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapHoriz" FullWidth="true"
                       Class="mt-3 replace-placeholder" OnClick="() => MudDialog.Close(DialogResult.Ok(ReplaceResult))" Disabled="_busy">
                Replace with…
            </MudButton>
        }
        @if (_problem is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">@_problem</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" OnClick="RemoveAsync" Disabled="_busy">Remove</MudButton>
        <MudSpacer />
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>The dialog's result when "Replace with…" is tapped.</summary>
    public const string ReplaceResult = "replace";

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string TripId { get; set; } = "";

    [Parameter, EditorRequired]
    public DateOnly Date { get; set; }

    [Parameter, EditorRequired]
    public SlotEntry Entry { get; set; } = default!;

    [Parameter]
    public UnitSystem UnitSystem { get; set; }

    /// <summary>The Food Item's servings per package, when recorded, so the amount can be typed in packages.</summary>
    [Parameter]
    public decimal? ServingsPerPackage { get; set; }

    private bool _byPackage;
    private string? _quantityText;
    private PlaceholderFields? _placeholder;
    private string? _problem;
    private bool _busy;

    protected override void OnInitialized()
    {
        _quantityText = ServingsInput.Format(Entry.Quantity);
        _placeholder = Entry.Placeholder is { } placeholder ? new PlaceholderFields(UnitSystem, placeholder) : null;
    }

    /// <summary>The typed amount in servings: packages × servings per package when typing packages.</summary>
    private decimal? TypedServings =>
        ServingsInput.Parse(_quantityText).Servings is { } typed
            ? _byPackage && ServingsPerPackage is { } perPackage ? typed * perPackage : typed
            : null;

    /// <summary>"1.5 packages (3 servings)" under the field, once a Food Item with servings per package has an amount.</summary>
    private string? AmountHelp => ServingsPerPackage is { } perPackage && TypedServings is { } servings
        ? ServingsInput.Amount(servings, perPackage)
        : null;

    /// <summary>Switching unit shows the same amount in the other one.</summary>
    private void SwitchUnit(bool byPackage)
    {
        if (byPackage != _byPackage && ServingsPerPackage is { } perPackage && ServingsInput.Parse(_quantityText).Servings is { } typed)
        {
            _quantityText = ServingsInput.Format(byPackage ? Math.Round(typed / perPackage, 2) : typed * perPackage);
        }

        _byPackage = byPackage;
    }

    private Task SaveAsync()
    {
        if (TypedServings is not { } amount)
        {
            return Task.CompletedTask;
        }

        if (_placeholder is null)
        {
            return RunAsync(() => App.Trips.UpdateSlotEntryAsync(TripId, Date, Entry.Id, amount));
        }

        return _placeholder.Read() is { } placeholder
            ? RunAsync(async () =>
            {
                await App.Trips.UpdatePlaceholderAsync(TripId, Date, Entry.Id, placeholder);
                await App.Trips.UpdateSlotEntryAsync(TripId, Date, Entry.Id, amount);
            })
            : Task.CompletedTask;
    }

    private Task RemoveAsync() => RunAsync(() => App.Trips.RemoveSlotEntryAsync(TripId, Date, Entry.Id));

    /// <summary>Runs a change and closes; if the core refuses it, shows why and keeps the dialog open.</summary>
    private async Task RunAsync(Func<Task> change)
    {
        _busy = true;
        _problem = null;
        try
        {
            await change();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (RuleViolationException ex)
        {
            _problem = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
