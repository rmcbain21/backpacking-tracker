@using BackpackingTracker.Core.Lists
@* Removing a list Category that has entries: asks which Category to move them to. Returns its id, or cancels. *@
<MudDialog>
    <DialogContent>
        <MudText Class="mb-2">@Plan.Message</MudText>
        <MudSelect T="string" @bind-Value="_targetId" Label="Move to" Class="move-target">
            @foreach (var category in Plan.MoveTargets)
            {
                <MudSelectItem Value="category.Id">@category.Name</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="_targetId is null"
                   OnClick="() => MudDialog.Close(DialogResult.Ok(_targetId))">Move and remove</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public CategoryRemovalPlan Plan { get; set; } = default!;

    private string? _targetId;
}
