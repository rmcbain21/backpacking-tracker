@* Removing a Category that Gear Items use: asks which Category to move them to. Returns its id, or cancels. *@
<MudDialog>
    <DialogContent>
        <MudText Class="mb-2">@Plan.Message</MudText>
        <MudSelect T="string" @bind-Value="_targetId" Label="Move to">
            @foreach (var category in Plan.MoveTargets)
            {
                <MudSelectItem Value="category.Id">@category.Name</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="_targetId is null" OnClick="Remove">
            Move and remove
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public CategoryRemovalPlan Plan { get; set; } = default!;

    private string? _targetId;

    private void Remove() => MudDialog.Close(DialogResult.Ok(_targetId));

    private void Cancel() => MudDialog.Cancel();
}
