@using BackpackingTracker.Core.Trips
@* Edits one Trip Day: its route (start, end, campsite, distances, elevation gain), journal notes, whether it's a
   Resupply (never day 1; locked on a Completed Trip) and, once the
   Trip has started, whether it was Skipped.
   Distances and elevation are typed in the chosen units. A refusal is shown here so nothing typed is lost. *@
@inject AppCore App
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (CanSkip || Day.Skipped)
            {
                <MudSwitch T="bool" @bind-Value="_skipped" Color="Color.Warning" Class="day-skipped"
                           Label="Skipped: planned but not hiked" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    The plan is kept. Stats leave the day out, except its planned distance and its food.
                </MudText>
            }
            @if (!IsFirstDay)
            {
                <MudSwitch T="bool" @bind-Value="_resupply" Color="Color.Primary" Class="day-resupply" Disabled="Locked"
                           Label="Resupply: food is restocked before this day" />
                @if (_resupply)
                {
                    <MudTextField @bind-Value="_resupplyPlace" Label="Resupply place (optional)" Class="day-resupply-place"
                                  Disabled="Locked" HelperText="Blank shows the day's start." />
                    @if (Day.Resupply)
                    {
                        <GearChangesEditor TripId="@TripId" Date="Day.Date" Locked="Locked" />
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Save, then open the day again to add gear changes.</MudText>
                    }
                }
            }
            <MudTextField @bind-Value="_start" Label="Start (optional)" Class="day-start" />
            <MudTextField @bind-Value="_end" Label="End (optional)" Class="day-end" />
            <MudTextField @bind-Value="_campsite" Label="Campsite (optional)" Class="day-campsite" />
            <div class="d-flex gap-3">
                <MudTextField @bind-Value="_plannedText" Label="Planned distance" InputMode="@(InputMode.@decimal)" Immediate="true"
                              Adornment="Adornment.End" AdornmentText="@RouteInput.DistanceLabel(UnitSystem)" Class="day-planned"
                              Validation="@(new Func<string?, string?>(text => ParsePlanned(text).Error))" />
                <MudTextField @bind-Value="_actualText" Label="Actual distance" InputMode="@(InputMode.@decimal)" Immediate="true"
                              Adornment="Adornment.End" AdornmentText="@RouteInput.DistanceLabel(UnitSystem)" Class="day-actual"
                              Validation="@(new Func<string?, string?>(text => ParseActual(text).Error))" />
            </div>
            <MudTextField @bind-Value="_elevationText" Label="Elevation gain" InputMode="@(InputMode.numeric)" Immediate="true"
                          Adornment="Adornment.End" AdornmentText="@RouteInput.ElevationLabel(UnitSystem)" Class="day-elevation"
                          Validation="@(new Func<string?, string?>(text => ParseElevation(text).Error))" />
            <MudTextField @bind-Value="_notes" Label="Journal notes (optional)" Lines="4" Sizing="InputSizing.Auto" Class="day-notes" />
        </MudForm>
        @if (_refusal is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@_refusal</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string TripId { get; set; } = "";

    [Parameter, EditorRequired]
    public TripDay Day { get; set; } = default!;

    [Parameter]
    public UnitSystem UnitSystem { get; set; }

    /// <summary>The Trip has started, so the day can be marked Skipped (a Skipped day can always be un-marked).</summary>
    [Parameter]
    public bool CanSkip { get; set; }

    /// <summary>Day 1, which can't be a Resupply.</summary>
    [Parameter]
    public bool IsFirstDay { get; set; }

    /// <summary>The Trip is Completed, so the Resupply switch is locked with the Meal Plan.</summary>
    [Parameter]
    public bool Locked { get; set; }

    private MudForm _form = default!;
    private string? _start;
    private string? _end;
    private string? _campsite;
    private string? _plannedText;
    private string? _actualText;
    private string? _elevationText;
    private string? _notes;
    private bool _skipped;
    private bool _resupply;
    private string? _resupplyPlace;
    private string? _refusal;

    protected override void OnInitialized()
    {
        _start = Day.Start;
        _end = Day.End;
        _campsite = Day.Campsite;
        _plannedText = RouteInput.DistanceText(Day.PlannedDistanceMetres, UnitSystem);
        _actualText = RouteInput.DistanceText(Day.ActualDistanceMetres, UnitSystem);
        _elevationText = RouteInput.ElevationText(Day.ElevationGainMetres, UnitSystem);
        _notes = Day.JournalNotes;
        _skipped = Day.Skipped;
        _resupply = Day.Resupply;
        _resupplyPlace = Day.ResupplyPlace;
    }

    private LengthParseResult ParsePlanned(string? text) => RouteInput.ParseDistance(text, UnitSystem, Day.PlannedDistanceMetres);

    private LengthParseResult ParseActual(string? text) => RouteInput.ParseDistance(text, UnitSystem, Day.ActualDistanceMetres);

    private LengthParseResult ParseElevation(string? text) => RouteInput.ParseElevation(text, UnitSystem, Day.ElevationGainMetres);

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        var planned = ParsePlanned(_plannedText);
        var actual = ParseActual(_actualText);
        var elevation = ParseElevation(_elevationText);
        if (!_form.IsValid || planned.Error is not null || actual.Error is not null || elevation.Error is not null)
        {
            return;
        }

        if (!Locked && Day.Resupply && !_resupply && !await ConfirmDroppingGearChangesAsync())
        {
            return;
        }

        try
        {
            await App.Trips.UpdateDayAsync(TripId, Day.Date, new TripDayDetails(
                _start, _end, _campsite, planned.Metres, actual.Metres, elevation.Metres, _notes));
            if (_skipped != Day.Skipped)
            {
                await App.Trips.SetDaySkippedAsync(TripId, Day.Date, _skipped);
            }

            var place = string.IsNullOrWhiteSpace(_resupplyPlace) ? null : _resupplyPlace.Trim();
            if (!Locked && !IsFirstDay && (_resupply != Day.Resupply || (_resupply && place != Day.ResupplyPlace)))
            {
                await App.Trips.SetResupplyAsync(TripId, Day.Date, _resupply, place);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (RuleViolationException ex)
        {
            _refusal = ex.Message;
        }
    }

    /// <summary>Turning off a Resupply removes its Gear Changes, so with any, it asks first. True to go ahead.</summary>
    private async Task<bool> ConfirmDroppingGearChangesAsync()
    {
        var day = (await App.Trips.GetTripAsync(TripId))?.Trip.Days.FirstOrDefault(d => d.Date == Day.Date);
        var count = day?.GearChanges.Count ?? 0;
        if (count == 0)
        {
            return true;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Turn off Resupply",
            $"This Resupply has {count} gear change{(count == 1 ? "" : "s")}. Turning it off removes {(count == 1 ? "it" : "them")}.",
            yesText: "Turn off", cancelText: "Cancel");
        return confirmed == true;
    }
}
