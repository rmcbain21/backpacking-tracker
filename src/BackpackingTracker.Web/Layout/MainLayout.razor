@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6">Backpacking Tracker</MudText>
        <MudSpacer />
        <MudIconButton Href="settings" Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit"
                       aria-label="Settings" />
    </MudAppBar>

    @* Tablet and desktop: navigation drawer *@
    <MudHidden Breakpoint="Breakpoint.Xs">
        <MudDrawer Open="true" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always" Elevation="1">
            <MudNavMenu Class="pt-2">
                @foreach (var item in NavItem.All)
                {
                    <MudNavLink Href="@item.Href" Match="@item.Match" Icon="@item.Icon">@item.Title</MudNavLink>
                }
            </MudNavMenu>
        </MudDrawer>
    </MudHidden>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-4 main-content">
            @Body
        </MudContainer>
    </MudMainContent>

    @* Phone: bottom navigation *@
    <MudHidden Breakpoint="Breakpoint.SmAndUp">
        <BottomNav />
    </MudHidden>
</MudLayout>
