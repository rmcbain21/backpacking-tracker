@using BackpackingTracker.Core.Lists
@inject IDialogService DialogService
@* One List Entry on a Gear List or Packing List: its gear and weight, with quantity, Carry Mode, move and remove (or just the quantity and Carry Mode, read-only). *@
<div class="pa-3 list-entry">
    <div class="d-flex align-center gap-2">
        <div class="flex-grow-1">
            @if (EntryView.GearItem is { } item)
            {
                <MudText>@item.Name@(item.Retired ? " (Retired)" : "")</MudText>
                @if (item.GearType.Length > 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@item.GearType</MudText>
                }
            }
            else
            {
                <MudText Class="mud-text-secondary">Deleted Gear Item</MudText>
            }
        </div>
        <MudText Class="text-nowrap entry-weight">@UnitFormat.Weight(EntryView.EntryWeightGrams, UnitSystem)</MudText>
    </div>
    @if (ReadOnly)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 entry-summary">× @Entry.Quantity · @Entry.CarryMode</MudText>
    }
    else
    {
        <div class="d-flex align-center gap-1 mt-1">
            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Disabled="Entry.Quantity <= 1"
                           aria-label="Fewer" OnClick="() => OnChange.InvokeAsync((Entry.Quantity - 1, Entry.CarryMode))" />
            <MudText Class="entry-quantity">@Entry.Quantity</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                           aria-label="More" OnClick="() => OnChange.InvokeAsync((Entry.Quantity + 1, Entry.CarryMode))" />
            @* Plain buttons that open a picker when tapped: a dropdown or menu on every row made long lists slow to open (idea 22). *@
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="carry-mode ml-2"
                       EndIcon="@Icons.Material.Filled.ArrowDropDown" aria-label="@($"Carry Mode: {Entry.CarryMode}")"
                       OnClick="PickCarryModeAsync">@Entry.CarryMode</MudButton>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" Disabled="Categories.Count < 2"
                           aria-label="@($"Move {EntryName} to another Category")" OnClick="PickCategoryAsync" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                           aria-label="Remove from list" OnClick="OnRemove" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ListEntryView EntryView { get; set; } = default!;

    /// <summary>The list's Categories, to move the entry to.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Category> Categories { get; set; } = [];

    [Parameter]
    public UnitSystem UnitSystem { get; set; }

    /// <summary>Shows the quantity and Carry Mode without the controls, as on a Completed Trip.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>A new quantity or Carry Mode.</summary>
    [Parameter]
    public EventCallback<(int Quantity, CarryMode CarryMode)> OnChange { get; set; }

    [Parameter]
    public EventCallback<Category> OnMove { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    private ListEntry Entry => EntryView.Entry;

    private string EntryName => EntryView.GearItem?.Name ?? "Deleted Gear Item";

    private async Task PickCarryModeAsync()
    {
        var choices = Enum.GetValues<CarryMode>().Select(mode => (mode.ToString(), mode)).ToList();
        if (await PickAsync("Carry Mode", choices, Entry.CarryMode, markCurrent: true) is (true, var mode) && mode != Entry.CarryMode)
        {
            await OnChange.InvokeAsync((Entry.Quantity, mode));
        }
    }

    private async Task PickCategoryAsync()
    {
        var choices = Categories.Where(c => c.Id != Entry.CategoryId).Select(c => (c.Name, c)).ToList();
        if (await PickAsync($"Move {EntryName} to", choices, current: null, markCurrent: false) is (true, { } target))
        {
            await OnMove.InvokeAsync(target);
        }
    }

    /// <summary>Shows the picker; Picked is false when the backpacker cancels.</summary>
    private async Task<(bool Picked, T? Value)> PickAsync<T>(string title, IReadOnlyList<(string, T)> choices, T? current, bool markCurrent)
    {
        var parameters = new DialogParameters<PickDialog<T>>
        {
            { d => d.Choices, choices },
            { d => d.Current, current },
            { d => d.MarkCurrent, markCurrent },
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall };
        var result = await (await DialogService.ShowAsync<PickDialog<T>>(title, parameters, options)).Result;
        return result is { Canceled: false, Data: T picked } ? (true, picked) : (false, default);
    }
}
