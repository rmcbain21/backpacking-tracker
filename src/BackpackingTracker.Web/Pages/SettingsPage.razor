@page "/settings"
@inject AppCore App
@inject ThemeState Theme

<PageTitle>Settings</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Settings</MudText>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.subtitle1">Units</MudText>
    <MudRadioGroup T="UnitSystem" Value="_unitSystem" ValueChanged="SetUnitSystemAsync">
        <MudRadio Value="UnitSystem.Imperial" Color="Color.Primary">Imperial (oz, lb, miles, feet)</MudRadio>
        <MudRadio Value="UnitSystem.Metric" Color="Color.Primary">Metric (g, kg, km, metres)</MudRadio>
    </MudRadioGroup>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
        Changes how values are shown. Stored weights and distances are not changed.
    </MudText>
</MudPaper>

<MudPaper Class="pa-4 mt-4">
    <MudText Typo="Typo.subtitle1">Colours</MudText>
    <div class="palette-choices mt-2" role="radiogroup" aria-label="Colour palette">
        @foreach (var option in AppThemes.All)
        {
            // Each swatch shows the palette's own colours, in light or dark as the app is now.
            var colours = IsDark ? Swatch(option.Theme.PaletteDark) : Swatch(option.Theme.PaletteLight);
            var chosen = option.Palette == Theme.Palette;
            <button type="button" role="radio" aria-checked="@(chosen ? "true" : "false")"
                    class="@($"palette-choice{(chosen ? " chosen" : "")}")" @onclick="() => SetPaletteAsync(option.Palette)">
                <span class="palette-swatch" style="@($"background:{colours.Background}")">
                    <span style="@($"background:{colours.Main}")"></span>
                    <span style="@($"background:{colours.Accent}")"></span>
                </span>
                <span class="palette-name">@option.Name</span>
            </button>
        }
    </div>

    <MudText Typo="Typo.subtitle2" Class="mt-4">Appearance</MudText>
    <div class="stacked-radios">
        <MudRadioGroup T="Appearance" Value="Theme.Appearance" ValueChanged="SetAppearanceAsync">
            <MudRadio Value="Appearance.MatchDevice" Color="Color.Primary">Match my device</MudRadio>
            <MudRadio Value="Appearance.Light" Color="Color.Primary">Light</MudRadio>
            <MudRadio Value="Appearance.Dark" Color="Color.Primary">Dark</MudRadio>
        </MudRadioGroup>
    </div>
</MudPaper>

<MudPaper Class="pa-4 mt-4">
    <MudText Typo="Typo.subtitle1">Gear</MudText>
    <MudButton Href="categories" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Category" Class="mt-1">
        Edit Default Categories
    </MudButton>
    <MudButton Href="gear/import" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.UploadFile" Class="mt-1">
        Import gear from CSV
    </MudButton>
</MudPaper>

@code {
    private UnitSystem _unitSystem;

    // Whether the app is showing dark colours now, from MainLayout's MudThemeProvider.
    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDark { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _unitSystem = (await App.Settings.GetAsync()).UnitSystem;
    }

    private async Task SetUnitSystemAsync(UnitSystem unitSystem)
    {
        _unitSystem = unitSystem;
        await App.Settings.SetUnitSystemAsync(unitSystem);
    }

    private async Task SetPaletteAsync(ColourPalette palette)
    {
        await App.Settings.SetPaletteAsync(palette);
        Theme.Set(palette, Theme.Appearance);
    }

    private async Task SetAppearanceAsync(Appearance appearance)
    {
        await App.Settings.SetAppearanceAsync(appearance);
        Theme.Set(Theme.Palette, appearance);
    }

    private static (string Background, string Main, string Accent) Swatch(Palette palette) =>
        (palette.Background.Value, palette.Primary.Value, palette.Secondary.Value);
}
