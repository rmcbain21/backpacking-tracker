@page "/trips/{TripId}"
@using BackpackingTracker.Core.Lists
@using BackpackingTracker.Core.Trips
@inject AppCore App
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@(_view?.Trip.Name ?? "Trip")</PageTitle>

<MudButton Href="trips" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack"
           Class="mb-1 ml-n2">Trips</MudButton>

@if (_loaded && _view is null)
{
    <MudText Typo="Typo.h5" HtmlTag="h1">Trip not found</MudText>
    <MudText Class="mud-text-secondary">It may have been deleted.</MudText>
}
else if (_view is not null)
{
    var trip = _view.Trip;
    <MudText Typo="Typo.h5" HtmlTag="h1">@trip.Name</MudText>
    <div class="d-flex align-center">
        <MudText Typo="Typo.body2" Class="mud-text-secondary trip-dates">@TripDates.Format(trip)</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small" aria-label="Change dates"
                       Class="change-dates" OnClick="ChangeDatesAsync" />
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2 trip-created-from">
        @trip.Status@(trip.CreatedFrom is null ? "" : $" · from Gear List \"{trip.CreatedFrom}\"")
    </MudText>

    <MudTabs @bind-ActivePanelIndex="_tab" Elevation="0" TabPanelsClass="pt-3" MinimumTabWidth="80px" Class="trip-tabs">
        <MudTabPanel Text="Packing List">@PackingList(trip)</MudTabPanel>
        <MudTabPanel Text="Checklist">@Checklist()</MudTabPanel>
        <MudTabPanel Text="Itinerary">@Itinerary(trip)</MudTabPanel>
    </MudTabs>

    @if (_tab == PackingListTab)
    {
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="add-fab" aria-label="Add gear to Packing List"
                OnClick="() => AddGearAsync(null)" />
    }
}

@code {
    private const int PackingListTab = 0;

    [Parameter]
    public string TripId { get; set; } = "";

    private UnitSystem _unitSystem;
    private TripView? _view;
    private bool _loaded;
    private int _tab = PackingListTab;

    private RenderFragment PackingList(Trip trip) => __builder =>
    {
        <PackTotals Weight="_view!.Weight" UnitSystem="_unitSystem">
            <MudDivider Class="my-2" />
            <div class="d-flex align-center pick-row water-carried" role="button" tabindex="0" aria-label="Set water carried"
                 @onclick="SetWaterAsync">
                <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
                <MudText Typo="Typo.body2" Class="flex-grow-1">Water carried</MudText>
                <MudText Typo="Typo.body2" Class="water-amount">
                    @(trip.WaterCarriedGrams is { } water ? $"{UnitFormat.WaterVolume(water)} · {UnitFormat.Weight(water, _unitSystem)}" : "None · tap to add")
                </MudText>
            </div>
        </PackTotals>

        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Changes here are for this Trip only.</MudText>

        @foreach (var categorySection in _view.Sections)
        {
            var category = categorySection.Category;
            <div class="d-flex align-center mt-4 mb-1 pl-1 category-heading" data-category="@category.Name">
                <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="flex-grow-1">@category.Name</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary text-nowrap category-subtotal">
                    @(categorySection.Entries.Count == 0 ? "Empty" : UnitFormat.Weight(categorySection.SubtotalGrams, _unitSystem))
                </MudText>
                @if (categorySection.IsOnList)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="@($"Add gear to {category.Name}")"
                                   OnClick="() => AddGearAsync(category.Id)" />
                }
            </div>
            @if (categorySection.Entries.Count > 0)
            {
                <MudPaper>
                    @foreach (var entryView in categorySection.Entries)
                    {
                        var entry = entryView.Entry;
                        <ListEntryRow EntryView="entryView" Categories="trip.PackingList.Categories" UnitSystem="_unitSystem"
                                      OnChange="change => TryAsync(() => App.Trips.UpdateEntryAsync(TripId, entry.Id, change.Quantity, change.CarryMode))"
                                      OnMove="target => TryAsync(() => App.Trips.MoveEntryAsync(TripId, entry.Id, target.Id))"
                                      OnRemove="() => TryAsync(() => App.Trips.RemoveEntryAsync(TripId, entry.Id))" />
                        <MudDivider />
                    }
                </MudPaper>
            }
        }
    };

    /// <summary>
    /// The packing checklist: progress and Reset, then each Packing List entry by Category as a full-width
    /// row that ticks or unticks with one tap anywhere on it.
    /// </summary>
    private RenderFragment Checklist() => __builder =>
    {
        var view = _view!;
        <MudPaper Class="pa-3 mb-3 checklist-progress">
            <div class="d-flex align-center gap-2">
                <MudText Class="flex-grow-1 packed-count">
                    @(view.ChecklistCount == 0 ? "Nothing on the Packing List yet" : $"{view.PackedCount} of {view.ChecklistCount} packed")
                </MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt"
                           Disabled="view.PackedCount == 0" OnClick="ResetPackedAsync" Class="reset-packed">Reset</MudButton>
            </div>
            <MudProgressLinear Value="@(view.ChecklistCount == 0 ? 0 : 100.0 * view.PackedCount / view.ChecklistCount)"
                               Color="Color.Primary" Rounded="true" Class="mt-1" />
        </MudPaper>

        @foreach (var checklistSection in view.Sections.Where(s => s.Entries.Count > 0))
        {
            <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="mt-3 mb-1 pl-1">@checklistSection.Category.Name</MudText>
            <MudPaper>
                @foreach (var entryView in checklistSection.Entries)
                {
                    var entry = entryView.Entry;
                    var name = entryView.GearItem?.Name ?? "Deleted Gear Item";
                    <div class="d-flex align-center px-2 pick-row checklist-row @(entry.Packed ? "packed" : "")"
                         role="checkbox" aria-checked="@(entry.Packed ? "true" : "false")" tabindex="0" aria-label="@name"
                         @onclick="() => TryAsync(() => App.Trips.SetPackedAsync(TripId, entry.Id, !entry.Packed))">
                        <MudIcon Icon="@(entry.Packed ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                 Color="@(entry.Packed ? Color.Primary : Color.Default)" Class="mr-3" />
                        <MudText Class="flex-grow-1 checklist-name">@name</MudText>
                        @if (entry.Quantity > 1)
                        {
                            <MudText Class="ml-2 text-nowrap checklist-quantity">× @entry.Quantity</MudText>
                        }
                        @if (entry.CarryMode == CarryMode.Worn)
                        {
                            <MudChip T="string" Size="Size.Small" Class="ml-2">Worn</MudChip>
                        }
                    </div>
                    <MudDivider />
                }
            </MudPaper>
        }
    };

    /// <summary>The Trip Days' route details in order, each opening that day for editing.</summary>
    private RenderFragment Itinerary(Trip trip) => __builder =>
    {
        <MudPaper Class="itinerary">
            @for (var i = 0; i < trip.Days.Count; i++)
            {
                var day = trip.Days[i];
                var dayNumber = i + 1;
                <div class="pa-3 pick-row trip-day" role="button" tabindex="0" data-date="@day.Date.ToString("yyyy-MM-dd")"
                     aria-label="@($"Edit Day {dayNumber}")" @onclick="() => EditDayAsync(day, dayNumber)">
                    <MudText Typo="Typo.subtitle2">Day @dayNumber · @TripDates.Day(day.Date)</MudText>
                    @if (!day.HasContent())
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing yet. Tap to add the route and notes.</MudText>
                    }
                    @if (RouteLine(day) is { } route)
                    {
                        <MudText Typo="Typo.body2" Class="day-route">@route</MudText>
                    }
                    @if (day.Campsite is not null)
                    {
                        <MudText Typo="Typo.body2" Class="day-campsite">Camp: @day.Campsite</MudText>
                    }
                    @if (FiguresLine(day) is { } figures)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary day-figures">@figures</MudText>
                    }
                    @if (day.JournalNotes is not null)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary day-notes">@day.JournalNotes</MudText>
                    }
                </div>
                <MudDivider />
            }
        </MudPaper>
    };

    /// <summary>"Start → End", or whichever of the two is filled in; null when neither is.</summary>
    private static string? RouteLine(TripDay day) => (day.Start, day.End) switch
    {
        (null, null) => null,
        ({ } start, null) => $"From {start}",
        (null, { } end) => $"To {end}",
        var (start, end) => $"{start} → {end}",
    };

    /// <summary>Such as "Planned 8.5 mi · Actual 9.0 mi · Gain 2,349 ft", leaving out what's empty.</summary>
    private string? FiguresLine(TripDay day)
    {
        var figures = new List<string>();
        if (day.PlannedDistanceMetres is { } planned)
        {
            figures.Add($"Planned {UnitFormat.Distance(planned, _unitSystem)}");
        }

        if (day.ActualDistanceMetres is { } actual)
        {
            figures.Add($"Actual {UnitFormat.Distance(actual, _unitSystem)}");
        }

        if (day.ElevationGainMetres is { } gain)
        {
            figures.Add($"Gain {UnitFormat.Elevation(gain, _unitSystem)}");
        }

        return figures.Count == 0 ? null : string.Join(" · ", figures);
    }

    protected override async Task OnParametersSetAsync()
    {
        _unitSystem = (await App.Settings.GetAsync()).UnitSystem;
        await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync() => _view = await App.Trips.GetTripAsync(TripId);

    private async Task EditDayAsync(TripDay day, int dayNumber)
    {
        var parameters = new DialogParameters<TripDayDialog>
        {
            { d => d.TripId, TripId },
            { d => d.Day, day },
            { d => d.UnitSystem, _unitSystem },
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<TripDayDialog>($"Day {dayNumber} · {TripDates.Day(day.Date)}", parameters, options);
        await dialog.Result;
        await LoadAsync();
    }

    private async Task SetWaterAsync()
    {
        var parameters = new DialogParameters<WaterDialog>
        {
            { d => d.TripId, TripId },
            { d => d.Grams, _view!.Trip.WaterCarriedGrams },
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<WaterDialog>("Water carried", parameters, options);
        await dialog.Result;
        await LoadAsync();
    }

    private async Task ResetPackedAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Reset checklist", $"Untick all {_view!.PackedCount} packed entries?", yesText: "Reset", cancelText: "Cancel");
        if (confirmed == true)
        {
            await TryAsync(() => App.Trips.ResetPackedAsync(TripId));
        }
    }

    private async Task ChangeDatesAsync()
    {
        var parameters = new DialogParameters<ChangeDatesDialog> { { d => d.Trip, _view!.Trip } };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ChangeDatesDialog>("Change dates", parameters, options);
        await dialog.Result;
        await LoadAsync();
    }

    /// <summary>Opens the picker; from a Category's + it starts on that Category, otherwise on the first.</summary>
    private async Task AddGearAsync(string? categoryId)
    {
        var categories = _view!.Trip.PackingList.Categories;
        var parameters = new DialogParameters<AddGearDialog>
        {
            { d => d.Add, (gearItemId, intoCategoryId) => App.Trips.AddEntryAsync(TripId, gearItemId, intoCategoryId) },
            { d => d.LoadEntries, async () => (await App.Trips.GetTripAsync(TripId))?.Trip.PackingList.Entries ?? [] },
            { d => d.Categories, categories },
            { d => d.CategoryId, categoryId ?? categories[0].Id },
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<AddGearDialog>("Add gear", parameters, options);
        await dialog.Result;
        await LoadAsync();
    }

    /// <summary>Runs a change, shows the reason if the core refuses it, and reloads the Trip.</summary>
    private async Task TryAsync(Func<Task> change)
    {
        try
        {
            await change();
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }

        await LoadAsync();
    }
}
