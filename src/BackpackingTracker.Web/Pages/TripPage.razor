    /// <summary>Adds the next day; when the last day has meals, asks whether to copy them onto it.</summary>
    private async Task AddDayAsync()
    {
        if (await AskCopyMealsAsync("Add day", "the new day") is { } copyMeals)
        {
            await TryAsync(() => App.Trips.AddDayAsync(TripId, copyMeals));
        }
    }

    /// <summary>Adds today, and any days missed before it, to an Open-ended Trip, then shows today.</summary>
    private async Task AddDaysUpToTodayAsync()
    {
        var missing = _view!.DaysToAddUpToToday;
        if (await AskCopyMealsAsync(missing == 1 ? "Add today" : $"Add {missing} days", missing == 1 ? "today" : "each new day") is { } copyMeals)
        {
            await TryAsync(() => App.Trips.AddDaysUpToTodayAsync(TripId, copyMeals));
        }
    }

    /// <summary>
    /// Whether new days copy the last day's meals: asked only when the last day has meals, otherwise false; null when
    /// the backpacker cancels.
    /// </summary>
    private async Task<bool?> AskCopyMealsAsync(string title, string onto)
    {
        var days = _view!.Trip.Days;
        if (days[^1].SlotEntries.Count == 0)
        {
            return false;
        }

        return await DialogService.ShowMessageBoxAsync(
            title, $"Copy Day {days.Count}'s meals onto {onto}?", yesText: "Copy meals", noText: "Start empty", cancelText: "Cancel");
    }

    /// <summary>Saves today's actual distance and journal notes typed on the Today tab, if they changed and the distance reads.</summary>
    private async Task SaveTodayAsync()
    {
        if (_view?.TodayDay is not { } day)
        {
            return;
        }

        var actual = RouteInput.ParseDistance(_actualText, _unitSystem, day.ActualDistanceMetres);
        var notes = string.IsNullOrWhiteSpace(_notesText) ? null : _notesText.Trim();
        if (actual.Error is not null || (actual.Metres == day.ActualDistanceMetres && notes == day.JournalNotes))
        {
            return;
        }

        try
        {
            await App.Trips.UpdateDayAsync(TripId, day.Date, new TripDayDetails(
                day.Start, day.End, day.Campsite, day.PlannedDistanceMetres, actual.Metres, day.ElevationGainMetres, notes));
            Snackbar.Add("Saved", Severity.Success, options => options.VisibleStateDuration = 1500);
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }

        await LoadAsync();
    }

    /// <summary>Opens the Meals tab's days scrolled to the day.</summary>
    private void OpenMeals(DateOnly date)
    {
        _tabName = MealsTab;
        _shopping = false;
        _pendingDay = date;
    }

    /// <summary>Removes the last day, asking first when it has anything filled in.</summary>
    private async Task RemoveLastDayAsync()
    {
        var days = _view!.Trip.Days;
        var last = days[^1];
        if (last.HasContent())
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                "Remove last day",
                $"Day {days.Count} ({TripDates.Day(last.Date)}) has things filled in, which will be lost. Remove it?",
                yesText: "Remove day", cancelText: "Cancel");
            if (confirmed != true)
            {
                return;
            }
        }

        await TryAsync(() => App.Trips.RemoveLastDayAsync(TripId, removeDayWithContent: true));
    }

