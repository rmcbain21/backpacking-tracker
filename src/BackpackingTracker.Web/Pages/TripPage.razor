    /// <summary>A slot entry's name and quantity; a Placeholder's in italics with a small ? icon.</summary>
    private static RenderFragment EntryName(SlotEntryView entryView, string name) => __builder =>
    {
        var quantity = entryView.Entry.Quantity == 1m ? "" : $" ×{ServingsInput.Format(entryView.Entry.Quantity)}";
        if (entryView.IsPlaceholder)
        {
            <span class="placeholder-name"><MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Class="placeholder-icon" aria-label="Placeholder" /><em>@name</em>@quantity</span>
        }
        else
        {
            @name@quantity
        }
    };

    /// <summary>
    /// A slot entry's calories and weight: "~400 cal · ~4 oz" for a Placeholder's estimates, with "no cal" or "no weight"
    /// for a blank one, or "no estimate" when both are.
    /// </summary>
    private string EntryFigures(SlotEntryView entryView)
    {
        if (!entryView.IsPlaceholder)
        {
            return $"{NutritionInput.Calories(entryView.Calories)} · {UnitFormat.Weight(entryView.WeightGrams, _unitSystem)}";
        }

        if (entryView.WithoutCalories && entryView.WithoutWeight)
        {
            return "no estimate";
        }

        var calories = entryView.WithoutCalories ? "no cal" : $"~{NutritionInput.Calories(entryView.Calories)}";
        var weight = entryView.WithoutWeight ? "no weight" : $"~{UnitFormat.Weight(entryView.WeightGrams, _unitSystem)}";
        return $"{calories} · {weight}";
    }

    /// <summary>"1,700 cal · 2 lb 2 oz", flagging Placeholders without an estimate: "2 lb 2 oz (1 without a weight)".</summary>
    private string FoodTotals(decimal calories, int withoutCalories, decimal grams, int withoutWeight) =>
        $"{NutritionInput.Calories(calories)}{Without(withoutCalories, "calories")} · {WeightTotal(grams, withoutWeight)}";

    /// <summary>"2 lb 2 oz", or "2 lb 2 oz (1 without a weight)" when Placeholders without a weight count as zero.</summary>
    private string WeightTotal(decimal grams, int withoutWeight) =>
        $"{UnitFormat.Weight(grams, _unitSystem)}{Without(withoutWeight, "a weight")}";

    private static string Without(int count, string what) => count == 0 ? "" : $" ({count} without {what})";

