@page "/trips/{TripId}"
@using BackpackingTracker.Core.Lists
@using BackpackingTracker.Core.Trips
@inject AppCore App
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_view?.Trip.Name ?? "Trip")</PageTitle>
<RefreshAfterSync OnChangesArrived="OnParametersSetAsync" />

<MudButton Href="trips" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack"
           Class="mb-1 ml-n2">Trips</MudButton>

@if (!_loaded)
{
    @* An outline of the page while the Trip loads, so the tap shows something at once (idea 22). *@
    <div class="trip-skeleton" aria-busy="true" aria-label="Loading the Trip">
        <MudSkeleton Width="60%" Height="40px" />
        <MudSkeleton Width="40%" />
        <MudSkeleton Width="50%" Class="mb-3" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Class="mb-3" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="96px" Class="mb-4" />
        @for (var row = 0; row < 4; row++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="64px" Class="mb-2" />
        }
    </div>
}
else if (_view is null)
{
    <MudText Typo="Typo.h5" HtmlTag="h1">Trip not found</MudText>
    <MudText Class="mud-text-secondary">It may have been deleted.</MudText>
}
else if (_view is not null)
{
    var trip = _view.Trip;
    <div class="d-flex align-center">
        <MudText Typo="Typo.h5" HtmlTag="h1" Class="flex-grow-1">@trip.Name</MudText>
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AriaLabel="Trip options">
            @if (Completed)
            {
                <MudMenuItem OnClick="ReopenAsync">Reopen</MudMenuItem>
            }
            else
            {
                <MudMenuItem OnClick="CompleteAsync">Mark Completed</MudMenuItem>
                <MudMenuItem OnClick="ToggleOpenEndedAsync" Class="toggle-open-ended">
                    @(trip.OpenEnded ? "Turn off Open-ended" : "Make Open-ended")
                </MudMenuItem>
            }
            <MudMenuItem OnClick="SaveAsGearListAsync">Save as Gear List</MudMenuItem>
            <MudMenuItem OnClick="DeleteAsync">Delete</MudMenuItem>
        </MudMenu>
    </div>
    <div class="d-flex align-center">
        <MudText Typo="Typo.body2" Class="mud-text-secondary trip-dates">@TripDates.Format(trip)</MudText>
        @if (!Completed)
        {
            <MudIconButton Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small" aria-label="Change dates"
                           Class="change-dates" OnClick="ChangeDatesAsync" />
        }
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2 trip-created-from">
        @trip.Status@(trip.OpenEnded ? " · Open-ended" : "")@(trip.CreatedFrom is null ? "" : $" · from Gear List \"{trip.CreatedFrom}\"")
    </MudText>
    @Progress(_view.Stats, "mb-2")
    @if (Completed)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2 completed-note">
            Weights and food are frozen as they were when completed. Reopen to change the Packing List, checklist, Meal Plan or dates.
        </MudAlert>
    }

    <MudTabs ActivePanelIndex="Array.IndexOf(Tabs, CurrentTab)" ActivePanelIndexChanged="index => _tabName = Tabs[index]"
             Elevation="0" TabPanelsClass="pt-3" MinimumTabWidth="64px" Class="trip-tabs">
        @if (_view.OnTrail)
        {
            <MudTabPanel Text="Today">@TodayTab()</MudTabPanel>
        }
        <MudTabPanel Text="Packing List">@PackingList(trip)</MudTabPanel>
        <MudTabPanel Text="Checklist">@Checklist()</MudTabPanel>
        <MudTabPanel Text="Itinerary">@Itinerary(trip)</MudTabPanel>
        <MudTabPanel Text="Meals">@MealPlan()</MudTabPanel>
        <MudTabPanel Text="Stats">@Stats()</MudTabPanel>
    </MudTabs>

    @if (CurrentTab == PackingListTab && !Completed)
    {
        <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" Class="add-fab" aria-label="Add gear to Packing List"
                OnClick="() => AddGearAsync(null)" />
    }
}

@code {
    private const string TodayTabName = "today";
    private const string PackingListTab = "packing";
    private const string ItineraryTab = "itinerary";
    private const string MealsTab = "meals";

    /// <summary>The tabs by their name in the address, in order; Today comes first, and only while the Trip is On Trail.</summary>
    private static readonly string[] PlanningTabs = [PackingListTab, "checklist", ItineraryTab, MealsTab, "stats"];
    private static readonly string[] OnTrailTabs = [TodayTabName, .. PlanningTabs];

    [Parameter]
    public string TripId { get; set; } = "";

    /// <summary>
    /// The tab to open on, such as trips/{id}?tab=checklist from the Trips card. When not given (or not shown), Today
    /// while the Trip is On Trail, otherwise Packing List.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    /// <summary>A Trip Day's date (yyyy-MM-dd): on the Itinerary tab its dialog opens, on the Meals tab the Meal Plan scrolls to it.</summary>
    [SupplyParameterFromQuery(Name = "day")]
    public string? Day { get; set; }

    /// <summary>The address last opened, so a reload after a sync keeps the tab the backpacker has moved to.</summary>
    private (string TripId, string? Tab, string? Day)? _opened;

    /// <summary>The day from the address still to open or scroll to, once the page has drawn it.</summary>
    private DateOnly? _pendingDay;

    private int _scrollTries;

    private UnitSystem _unitSystem;
    private TripView? _view;
    private bool _loaded;

    /// <summary>The tab chosen, by name: from the address, then whichever the backpacker taps; null for the default.</summary>
    private string? _tabName;

    /// <summary>The Meals tab shows the shopping list (per Food Carry) instead of the days.</summary>
    private bool _shopping;

    /// <summary>Food Carries, by first date, whose cards have been tapped open or closed from how they start.</summary>
    private readonly HashSet<DateOnly> _toggledCarries = [];

    /// <summary>Today's actual distance and journal notes as typed on the Today tab, saved when the field is left.</summary>
    private string? _actualText;
    private string? _notesText;

    /// <summary>A Completed Trip's Packing List, checklist and dates are locked until it's Reopened.</summary>
    private bool Completed => _view?.Trip.Status == TripStatus.Completed;

    private string[] Tabs => _view?.OnTrail == true ? OnTrailTabs : PlanningTabs;

    /// <summary>The tab showing: the one chosen if it's shown, otherwise Today while On Trail, otherwise Packing List.</summary>
    private string CurrentTab => _tabName is { } name && Tabs.Contains(name) ? name : Tabs[0];

    /// <summary>
    /// The Today tab while On Trail (idea 28): today's Trip Day with its actual distance and journal notes editable in
    /// place, the distance so far, today's meals and tomorrow, then finishing. An Open-ended Trip without a day for today
    /// shows a button to add it (and any missed days before it) instead of the day.
    /// </summary>
    private RenderFragment TodayTab() => __builder =>
    {
        var view = _view!;
        var trip = view.Trip;
        var heading = $"Day {view.TodayNumber}{(trip.OpenEnded ? "" : $" of {trip.Days.Count}")} · {TripDates.Day(view.Today)}";
        if (view.TodayDay is not { } today)
        {
            var missing = view.DaysToAddUpToToday;
            <MudPaper Class="pa-3 mb-3 add-today">
                <MudText Typo="Typo.h6" HtmlTag="h2">@heading</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Today isn't on the Trip yet.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddDaysUpToTodayAsync" Class="add-today-button">
                    @(missing == 1 ? $"Add today (Day {view.TodayNumber})" : $"Add {missing} days up to today")
                </MudButton>
            </MudPaper>
            @SoFar(view)
            @Finishing(view)
            return;
        }

        <MudPaper Class="pa-3 mb-3 today-day">
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="flex-grow-1 today-heading">@heading</MudText>
                @if (today.Skipped)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                             Icon="@Icons.Material.Filled.DoNotDisturbOn" Class="day-skipped-chip ma-0">Skipped</MudChip>
                }
            </div>
            @if (today.Skipped)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="ml-n2 unskip-today"
                           OnClick="() => TryAsync(() => App.Trips.SetDaySkippedAsync(TripId, today.Date, false))">Not Skipped after all</MudButton>
            }
            @if (RouteLine(today) is { } route)
            {
                <MudText Typo="Typo.body2" Class="day-route">@route</MudText>
            }
            @if (today.Campsite is not null)
            {
                <MudText Typo="Typo.body2" Class="day-campsite">Camp: @today.Campsite</MudText>
            }
            @if (today.PlannedDistanceMetres is { } planned)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Planned @UnitFormat.Distance(planned, _unitSystem)</MudText>
            }
            <MudTextField @bind-Value="_actualText" Label="Actual distance" InputMode="@(InputMode.@decimal)" Immediate="true"
                          Adornment="Adornment.End" AdornmentText="@RouteInput.DistanceLabel(_unitSystem)" Class="today-actual"
                          Validation="@(new Func<string?, string?>(text => RouteInput.ParseDistance(text, _unitSystem, today.ActualDistanceMetres).Error))"
                          OnBlur="SaveTodayAsync" />
            <MudTextField @bind-Value="_notesText" Label="Journal notes" Lines="3" Sizing="InputSizing.Auto" Immediate="true"
                          Class="today-notes" OnBlur="SaveTodayAsync" />
            <div class="d-flex justify-end mt-2">
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" Class="edit-today"
                           OnClick="() => EditDayAsync(today, view.TodayNumber)">Edit day</MudButton>
            </div>
        </MudPaper>

        @SoFar(view)

        var todayPlan = view.MealPlan.Days.First(dayPlan => dayPlan.Day.Date == today.Date);
        <MudPaper Class="pa-3 mb-3 pick-row today-meals" role="button" tabindex="0" aria-label="Open today's meals"
                  @onclick="() => OpenMeals(today.Date)">
            <div class="d-flex justify-space-between">
                <MudText Typo="Typo.subtitle2" HtmlTag="h2">Today's meals</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary text-nowrap today-eaten">
                    @(today.SlotEntries.Count == 0 ? "Nothing planned" : NutritionInput.Eaten(todayPlan.EatenCalories, todayPlan.Calories))
                </MudText>
            </div>
            @foreach (var slotView in todayPlan.Slots.Where(slotView => slotView.Entries.Count > 0))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1 today-slot">@slotView.Slot</MudText>
                @foreach (var entryView in slotView.Entries)
                {
                    var name = entryView.Name ?? (entryView.IsMeal ? "Deleted Meal" : "Deleted Food Item");
                    <div class="d-flex align-center ml-n2 today-slot-entry @(entryView.Entry.Eaten ? "eaten" : "")">
                        @EatenTick(todayPlan, entryView, name)
                        <MudText Typo="Typo.body2">
                            @EntryName(entryView, name)
                        </MudText>
                    </div>
                }
            }
        </MudPaper>

        @FoodLeft(view)

        @if (view.TomorrowDay is { } tomorrow)
        {
            <MudPaper Class="pa-3 mb-3 pick-row today-tomorrow" role="button" tabindex="0" aria-label="Open tomorrow"
                      @onclick="() => EditDayAsync(tomorrow, view.TodayNumber + 1)">
                <MudText Typo="Typo.body2">@TomorrowLine(tomorrow)</MudText>
            </MudPaper>
        }

        @Finishing(view)
    };

    /// <summary>"52.3 mi hiked in 4 days · 13.1 mi/day", then progress against the Expected Distance if there is one.</summary>
    private RenderFragment SoFar(TripView view) => __builder =>
    {
        var soFar = view.SoFar;
        <MudPaper Class="pa-3 mb-3 today-so-far">
            <MudText Typo="Typo.subtitle2" HtmlTag="h2">Distance so far</MudText>
            <MudText Typo="Typo.body2" Class="so-far-distance">
                @UnitFormat.Distance(soFar.Metres, _unitSystem) hiked in @Plural(soFar.Days, "day")@(soFar.MetresPerDay is { } perDay ? $" · {UnitFormat.Distance(perDay, _unitSystem)}/day" : "")
            </MudText>
            @Progress(view.Stats, "mt-2")
        </MudPaper>
    };

    /// <summary>
    /// "Food left: 3.2 lb · 2 days to Kennedy Meadows", then "Next resupply: Kennedy Meadows, day 5 (in 2 days)" or, on
    /// the day, "Resupply today: Kennedy Meadows · 3 of 12 bought". Tapping opens that Food Carry's shopping list (the
    /// current one when there's no later Resupply). Nothing without food planned or a Resupply to come.
    /// </summary>
    private RenderFragment FoodLeft(TripView view) => __builder =>
    {
        if (view.CurrentFoodCarry is not { } current || view.FoodLeftGrams is not { } left)
        {
            return;
        }

        var next = view.NextResupply;
        if (left == 0 && next is null)
        {
            return;
        }

        var later = view.MealPlan.FoodCarries.FirstOrDefault(carry => !carry.FromHome && carry.FirstDate > view.Today);
        var daysTo = later is null ? 0 : later.FirstDate.DayNumber - view.Today.DayNumber;
        <MudPaper Class="pa-3 mb-3 pick-row today-food" role="button" tabindex="0" aria-label="Open the shopping list"
                  @onclick="() => OpenShopping(next ?? current)">
            <MudText Typo="Typo.subtitle2" HtmlTag="h2">Food</MudText>
            <MudText Typo="Typo.body2" Class="food-left">
                Food left: @UnitFormat.Weight(left, _unitSystem)@(later is null ? "" : $" · {Plural(daysTo, "day")} to {FoodCarryName(later)}")
            </MudText>
            @if (next is not null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary next-resupply">
                    @(next.FirstDate == view.Today
                        ? $"Resupply today: {FoodCarryName(next)} · {next.BoughtCount} of {next.LineCount} bought"
                        : $"Next resupply: {FoodCarryName(next)}, day {next.FirstDayNumber} (in {Plural(daysTo, "day")})")
                </MudText>
            }
        </MudPaper>
    };

    /// <summary>On a fixed-date Trip's last day, a reminder to Complete it; on an Open-ended Trip, a small link to finish it.</summary>
    private RenderFragment Finishing(TripView view) => __builder =>
    {
        if (view.IsLastDay)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3 last-day">
                <div class="d-flex align-center flex-wrap gap-2">
                    <span class="flex-grow-1">Last day: Mark Completed when you're off trail.</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CompleteAsync">Mark Completed</MudButton>
                </div>
            </MudAlert>
        }
        else if (view.Trip.OpenEnded)
        {
            <div class="d-flex justify-center">
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CompleteAsync" Class="finish-trip">Finish the Trip</MudButton>
            </div>
        }
    };

    /// <summary>"Tomorrow: Tuolumne → Glen Aulin, 12.4 mi", leaving out what's empty.</summary>
    private string TomorrowLine(TripDay tomorrow)
    {
        var parts = new[] { RouteLine(tomorrow), tomorrow.PlannedDistanceMetres is { } planned ? UnitFormat.Distance(planned, _unitSystem) : null }
            .OfType<string>().ToList();
        return parts.Count == 0 ? "Tomorrow: nothing planned yet" : $"Tomorrow: {string.Join(", ", parts)}";
    }

    private RenderFragment PackingList(Trip trip) => __builder =>
    {
        <PackTotals Weight="_view!.Weight" UnitSystem="_unitSystem" ShrinksToTop="true">
            <MudDivider Class="my-2" />
            <div class="d-flex align-center pick-row water-carried" role="button" tabindex="0" aria-label="Set water carried"
                 @onclick="SetWaterAsync">
                <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
                <MudText Typo="Typo.body2" Class="flex-grow-1">Water carried</MudText>
                <MudText Typo="Typo.body2" Class="water-amount">
                    @(trip.WaterCarriedGrams is { } water ? $"{UnitFormat.WaterVolume(water)} · {UnitFormat.Weight(water, _unitSystem)}" : "None · tap to add")
                </MudText>
            </div>
        </PackTotals>

        @if (!Completed)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Changes here are for this Trip only.</MudText>
        }

        @foreach (var categorySection in _view.Sections)
        {
            var category = categorySection.Category;
            <div class="d-flex align-center mt-4 mb-1 pl-1 category-heading" data-category="@category.Name">
                <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="flex-grow-1">@category.Name</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary text-nowrap category-subtotal">
                    @(categorySection.Entries.Count == 0 ? "Empty" : UnitFormat.Weight(categorySection.SubtotalGrams, _unitSystem))
                </MudText>
                @if (categorySection.IsOnList && !Completed)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="@($"Add gear to {category.Name}")"
                                   OnClick="() => AddGearAsync(category.Id)" />
                }
            </div>
            @if (categorySection.Entries.Count > 0)
            {
                <MudPaper>
                    @foreach (var entryView in categorySection.Entries)
                    {
                        var entry = entryView.Entry;
                        <ListEntryRow EntryView="entryView" Categories="trip.PackingList.Categories" UnitSystem="_unitSystem" ReadOnly="Completed"
                                      OnChange="change => TryAsync(() => App.Trips.UpdateEntryAsync(TripId, entry.Id, change.Quantity, change.CarryMode))"
                                      OnMove="target => TryAsync(() => App.Trips.MoveEntryAsync(TripId, entry.Id, target.Id))"
                                      OnRemove="() => TryAsync(() => App.Trips.RemoveEntryAsync(TripId, entry.Id))" />
                        <MudDivider />
                    }
                </MudPaper>
            }
        }
    };

    /// <summary>
    /// The packing checklist: progress and Reset, then each Packing List entry by Category as a full-width
    /// row that ticks or unticks with one tap anywhere on it. Read-only on a Completed Trip.
    /// </summary>
    private RenderFragment Checklist() => __builder =>
    {
        var view = _view!;
        <MudPaper Class="pa-3 mb-3 checklist-progress">
            <div class="d-flex align-center gap-2">
                <MudText Class="flex-grow-1 packed-count">
                    @(view.ChecklistCount == 0 ? "Nothing on the Packing List yet" : $"{view.PackedCount} of {view.ChecklistCount} packed")
                </MudText>
                @if (!Completed)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt"
                               Disabled="view.PackedCount == 0" OnClick="ResetPackedAsync" Class="reset-packed">Reset</MudButton>
                }
            </div>
            <MudProgressLinear Value="@(view.ChecklistCount == 0 ? 0 : 100.0 * view.PackedCount / view.ChecklistCount)"
                               Color="Color.Primary" Rounded="true" Class="mt-1" />
        </MudPaper>

        @foreach (var checklistSection in view.Sections.Where(s => s.Entries.Count > 0))
        {
            <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="mt-3 mb-1 pl-1">@checklistSection.Category.Name</MudText>
            <MudPaper>
                @foreach (var entryView in checklistSection.Entries)
                {
                    var entry = entryView.Entry;
                    var name = entryView.GearItem?.Name ?? "Deleted Gear Item";
                    <div class="d-flex align-center px-2 checklist-row @(Completed ? "" : "pick-row") @(entry.Packed ? "packed" : "")"
                         role="checkbox" aria-checked="@(entry.Packed ? "true" : "false")" aria-readonly="@(Completed ? "true" : "false")"
                         tabindex="@(Completed ? -1 : 0)" aria-label="@name"
                         @onclick="() => Completed ? Task.CompletedTask : TryAsync(() => App.Trips.SetPackedAsync(TripId, entry.Id, !entry.Packed))">
                        <MudIcon Icon="@(entry.Packed ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                 Color="@(entry.Packed ? Color.Primary : Color.Default)" Class="mr-3" />
                        <MudText Class="flex-grow-1 checklist-name">@name</MudText>
                        @if (entry.Quantity > 1)
                        {
                            <MudText Class="ml-2 text-nowrap checklist-quantity">× @entry.Quantity</MudText>
                        }
                        @if (entry.CarryMode == CarryMode.Worn)
                        {
                            <MudChip T="string" Size="Size.Small" Class="ml-2">Worn</MudChip>
                        }
                    </div>
                    <MudDivider />
                }
            </MudPaper>
        }
    };

    /// <summary>The Trip Days' route details in order, each opening that day for editing.</summary>
    private RenderFragment Itinerary(Trip trip) => __builder =>
    {
        <MudPaper Class="itinerary">
            @for (var i = 0; i < trip.Days.Count; i++)
            {
                var day = trip.Days[i];
                var dayNumber = i + 1;
                <div class="@($"pa-3 pick-row trip-day{(day.Skipped ? " trip-day-skipped" : "")}")" role="button" tabindex="0"
                     data-date="@day.Date.ToString("yyyy-MM-dd")"
                     aria-label="@($"Edit Day {dayNumber}{(day.Skipped ? ", Skipped" : "")}")" @onclick="() => EditDayAsync(day, dayNumber)">
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.subtitle2">Day @dayNumber · @TripDates.Day(day.Date)</MudText>
                        @if (day.Skipped)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.DoNotDisturbOn" Class="day-skipped-chip ma-0">Skipped</MudChip>
                        }
                    </div>
                    @if (!day.HasContent())
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing yet. Tap to add the route and notes.</MudText>
                    }
                    @if (day.Resupply && dayNumber > 1)
                    {
                        <MudText Typo="Typo.body2" Class="d-flex align-center gap-1 day-resupply-line">
                            <MudIcon Icon="@Icons.Material.Filled.ShoppingBasket" Size="Size.Small" Color="Color.Primary" />
                            Resupply@(ResupplyName(day) is { } place ? $": {place}" : "")
                        </MudText>
                    }
                    @if (RouteLine(day) is { } route)
                    {
                        <MudText Typo="Typo.body2" Class="day-route">@route</MudText>
                    }
                    @if (day.Campsite is not null)
                    {
                        <MudText Typo="Typo.body2" Class="day-campsite">Camp: @day.Campsite</MudText>
                    }
                    @if (FiguresLine(day) is { } figures)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary day-figures">@figures</MudText>
                    }
                    @if (day.JournalNotes is not null)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary day-notes">@day.JournalNotes</MudText>
                    }
                </div>
                <MudDivider />
            }
        </MudPaper>
        @if (trip.OpenEnded && !Completed)
        {
            <div class="d-flex justify-end gap-2 mt-3 open-ended-days">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Remove" Disabled="trip.Days.Count == 1"
                           OnClick="RemoveLastDayAsync" Class="remove-last-day">Remove last day</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddDayAsync" Class="add-day">Add day</MudButton>
            </div>
        }
    };

    /// <summary>
    /// Progress against the Expected Distance, such as "1,032 mi of 2,650 mi (39%) · 1,618 mi to go", and on an
    /// Open-ended Trip the finish estimate once there is one; nothing without an Expected Distance.
    /// </summary>
    private RenderFragment Progress(TripStats stats, string spacing) => __builder =>
    {
        if (stats.Progress is not { } progress)
        {
            return;
        }

        <div class="@($"{spacing} trip-progress")">
            <MudText Typo="Typo.body2" Class="progress-distance">
                @UnitFormat.WholeDistance(progress.ActualMetres, _unitSystem) of @UnitFormat.WholeDistance(progress.ExpectedMetres, _unitSystem)
                (@progress.Percent%) · @UnitFormat.WholeDistance(progress.RemainingMetres, _unitSystem) to go
            </MudText>
            <MudProgressLinear Value="@Math.Min(progress.Percent, 100)" Color="Color.Primary" Rounded="true" Class="my-1" />
            @if (stats.FinishEstimate is { } estimate)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary finish-estimate">
                    At your pace: about @TripDates.Date(estimate.Date) (≈ @Plural(estimate.DaysToGo, "day") to go)
                </MudText>
            }
        </div>
    };

    /// <summary>
    /// The Meal Plan: each Trip Day's Breakfast, Lunch, Dinner and Snacks with what's in them, and the day's calories
    /// and food weight. On a Planned Trip, a slot's + adds to it and tapping an entry changes or removes it. Once the
    /// Trip has started, each entry has an eaten tick, and each day its calories eaten and an All eaten action.
    /// </summary>
    private RenderFragment MealPlan() => __builder =>
    {
        var plan = _view!.MealPlan;
        <MudToggleGroup T="bool" Value="_shopping" ValueChanged="shopping => _shopping = shopping" Color="Color.Primary"
                        Size="Size.Small" Class="mb-3 meals-view">
            <MudToggleItem Value="false" Text="By day" />
            <MudToggleItem Value="true" Text="Shopping" />
        </MudToggleGroup>
        <MudPaper Class="pa-3 mb-3 meal-plan-total">
            <div class="d-flex justify-space-between">
                <MudText Typo="Typo.body2">Food for the Trip</MudText>
                <MudText Typo="Typo.body2" Class="text-nowrap">
                    @FoodTotals(plan.Calories, plan.WithoutCalories, plan.FoodGrams, plan.WithoutWeight)
                </MudText>
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @(plan.Resupplies == 0
                    ? "Counted in the Consumable Weight."
                    : $"Only the food from home ({UnitFormat.Weight(plan.StartingFoodGrams, _unitSystem)}) counts in the Consumable Weight.")
            </MudText>
        </MudPaper>
        @if (_shopping)
        {
            @Shopping(plan)
            return;
        }
        @if (!Completed)
        {
            <div class="d-flex justify-end mt-n2 mb-1">
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="CopyMealPlanAsync" Class="copy-meal-plan">Copy from another Trip</MudButton>
            </div>
        }

        @foreach (var dayPlan in plan.Days)
        {
            <MudPaper Class="mb-3 meal-plan-day" data-date="@dayPlan.Day.Date.ToString("yyyy-MM-dd")">
                <div class="d-flex align-center px-3 pt-3 pb-1">
                    <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Day @dayPlan.DayNumber · @TripDates.Day(dayPlan.Day.Date)</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary text-nowrap day-food-total">
                        @(dayPlan.Day.SlotEntries.Count == 0 ? "Nothing planned" : FoodTotals(dayPlan.Calories, dayPlan.WithoutCalories, dayPlan.FoodGrams, dayPlan.WithoutWeight))
                    </MudText>
                </div>
                @if (dayPlan.Day.Resupply && dayPlan.DayNumber > 1)
                {
                    <MudText Typo="Typo.body2" Class="d-flex align-center gap-1 px-3 day-resupply-line">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingBasket" Size="Size.Small" Color="Color.Primary" />
                        Resupply@(ResupplyName(dayPlan.Day) is { } place ? $": {place}" : "")
                    </MudText>
                }
                @if (ShowsEaten && dayPlan.Day.SlotEntries.Count > 0)
                {
                    <div class="d-flex align-center pl-3 pr-1 day-eaten">
                        <MudText Typo="Typo.body2" Class="flex-grow-1 day-eaten-calories">
                            @NutritionInput.Eaten(dayPlan.EatenCalories, dayPlan.Calories)
                        </MudText>
                        @if (CanTickEaten && !dayPlan.AllEaten)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.DoneAll" Class="all-eaten"
                                       OnClick="() => TryAsync(() => App.Trips.SetDayEatenAsync(TripId, dayPlan.Day.Date))">All eaten</MudButton>
                        }
                    </div>
                }
                @foreach (var slotView in dayPlan.Slots)
                {
                    var slot = slotView.Slot;
                    <div class="d-flex align-center pl-3 pr-1 meal-slot-heading">
                        <MudText Typo="Typo.caption" Class="flex-grow-1 mud-text-secondary meal-slot-name">@slot</MudText>
                        @if (!Completed)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                           aria-label="@($"Add to Day {dayPlan.DayNumber} {slot}")"
                                           OnClick="() => AddToSlotAsync(dayPlan, slot)" />
                        }
                    </div>
                    @foreach (var entryView in slotView.Entries)
                    {
                        var name = entryView.Name ?? (entryView.IsMeal ? "Deleted Meal" : "Deleted Food Item");
                        <div class="d-flex align-center @(ShowsEaten ? "pl-1" : "pl-3") pr-3 py-1 gap-2 slot-entry @(Completed ? "" : "pick-row") @(entryView.Entry.Eaten ? "eaten" : "")"
                             role="button" tabindex="@(Completed ? -1 : 0)" aria-label="@($"Change {name}")"
                             @onclick="() => Completed ? Task.CompletedTask : EditSlotEntryAsync(dayPlan, entryView, name)">
                            @EatenTick(dayPlan, entryView, name)
                            <MudText Typo="Typo.body2" Class="flex-grow-1">
                                @EntryName(entryView, name)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary text-nowrap slot-entry-figures">
                                @EntryFigures(entryView)
                            </MudText>
                        </div>
                    }
                }
                <div class="pb-2"></div>
            </MudPaper>
        }
    };

    /// <summary>Food can be ticked as eaten: the Trip has started and isn't Completed.</summary>
    private bool CanTickEaten => _view!.HasStarted && !Completed;

    /// <summary>The eaten ticks show once the Trip has started, read-only on a Completed Trip.</summary>
    private bool ShowsEaten => _view!.HasStarted;

    /// <summary>
    /// A slot entry's eaten tick: tapping it ticks or unticks the entry without opening anything else. Nothing before
    /// the Trip has started; read-only on a Completed Trip.
    /// </summary>
    private RenderFragment EatenTick(DayMealPlan dayPlan, SlotEntryView entryView, string name) => __builder =>
    {
        if (!ShowsEaten)
        {
            return;
        }

        var eaten = entryView.Entry.Eaten;
        var icon = eaten ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle;
        var color = eaten ? Color.Primary : Color.Default;
        if (!CanTickEaten)
        {
            <MudIcon Icon="@icon" Color="@color" Size="Size.Small" Class="mx-2 eaten-tick" aria-label="@(eaten ? "Eaten" : "Not eaten")" />
            return;
        }

        <span class="eaten-tick" @onclick:stopPropagation="true">
            <MudIconButton Icon="@icon" Color="@color" Size="Size.Small"
                           aria-label="@($"{name} eaten")" aria-pressed="@(eaten ? "true" : "false")"
                           OnClick="() => TryAsync(() => App.Trips.SetSlotEntryEatenAsync(TripId, dayPlan.Day.Date, entryView.Entry.Id, !eaten))" />
        </span>
    };

    /// <summary>
    /// The shopping list: one card per Food Carry, headed "Kennedy Meadows · days 5–9" with its food weight, calories and
    /// how much is bought, then one line per Food Item with its servings and weight, ticked as bought with a tap
    /// (read-only on a Completed Trip). Food Carries that are over start collapsed; tapping a heading opens or closes it.
    /// </summary>
    private RenderFragment Shopping(MealPlanView plan) => __builder =>
    {
        @foreach (var carry in plan.FoodCarries)
        {
            var open = IsOpen(carry);
            var title = $"{FoodCarryName(carry)} · {DaysText(carry)}";
            <MudPaper Class="mb-3 food-carry" data-date="@carry.FirstDate.ToString("yyyy-MM-dd")">
                <div class="d-flex align-center pa-3 pick-row food-carry-heading" role="button" tabindex="0"
                     aria-expanded="@(open ? "true" : "false")" aria-label="@title" @onclick="() => ToggleCarry(carry)">
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.subtitle2" HtmlTag="h3">@title</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary food-carry-totals">
                            @UnitFormat.Weight(carry.FoodGrams, _unitSystem) food@(Without(carry.WithoutWeight, "a weight")) · @NutritionInput.Calories(carry.Calories)@Without(carry.WithoutCalories, "calories")@(carry.LineCount == 0 ? "" : $" · {carry.BoughtCount} of {carry.LineCount} bought")
                        </MudText>
                    </div>
                    <MudIcon Icon="@(open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                </div>
                @if (open)
                {
                    <MudDivider />
                    @if (carry.LineCount == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-3">Nothing planned for these days.</MudText>
                    }
                    @foreach (var line in carry.Lines)
                    {
                        var name = line.Name ?? "Deleted Food Item";
                        <div class="d-flex align-center px-2 py-1 shopping-line @(Completed ? "" : "pick-row") @(line.Bought ? "bought" : "")"
                             role="checkbox" aria-checked="@(line.Bought ? "true" : "false")" aria-readonly="@(Completed ? "true" : "false")"
                             tabindex="@(Completed ? -1 : 0)" aria-label="@name"
                             @onclick="() => Completed ? Task.CompletedTask : TryAsync(() => App.Trips.SetBoughtAsync(TripId, carry.FirstDate, line.FoodItemId, !line.Bought))">
                            <MudIcon Icon="@(line.Bought ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                     Color="@(line.Bought ? Color.Primary : Color.Default)" Class="mr-3" />
                            <MudText Typo="Typo.body2" Class="flex-grow-1 shopping-name">@name</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary text-nowrap shopping-amount">
                                @ServingsText(line.Servings) · @UnitFormat.Weight(line.WeightGrams, _unitSystem)
                            </MudText>
                        </div>
                    }
                    @if (carry.PlaceholderLines.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block px-3 pt-2 to-choose-heading" HtmlTag="h4">To choose at the store</MudText>
                        @foreach (var line in carry.PlaceholderLines)
                        {
                            var name = PlaceholderLineName(line);
                            <div class="d-flex align-center px-2 py-1 shopping-line placeholder-line @(Completed ? "" : "pick-row") @(line.Bought ? "bought" : "")"
                                 role="checkbox" aria-checked="@(line.Bought ? "true" : "false")" aria-readonly="@(Completed ? "true" : "false")"
                                 tabindex="@(Completed ? -1 : 0)" aria-label="@name"
                                 @onclick="() => Completed ? Task.CompletedTask : TryAsync(() => App.Trips.SetPlaceholderBoughtAsync(TripId, carry.FirstDate, line.Slot, line.Label, !line.Bought))">
                                <MudIcon Icon="@(line.Bought ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                         Color="@(line.Bought ? Color.Primary : Color.Default)" Class="mr-3" />
                                <MudText Typo="Typo.body2" Class="flex-grow-1 shopping-name"><em>@name</em> ×@ServingsInput.Format(line.Quantity)</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary text-nowrap shopping-amount">
                                    @PlaceholderLineWeight(line)
                                </MudText>
                            </div>
                        }
                    }
                    @if (!Completed && carry.BoughtCount > 0)
                    {
                        <div class="d-flex justify-end pa-1">
                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt" Class="reset-bought"
                                       OnClick="() => ResetBoughtAsync(carry)">Reset</MudButton>
                        </div>
                    }
                }
            </MudPaper>
        }
    };

    /// <summary>"From home", the Resupply's place (or its day's start), or "Day 5 resupply" when neither is filled in.</summary>
    private static string FoodCarryName(FoodCarry carry) =>
        carry.FromHome ? "From home" : carry.Place ?? $"Day {carry.FirstDayNumber} resupply";

    /// <summary>"days 5–9", or "day 5" for a one-day Food Carry.</summary>
    private static string DaysText(FoodCarry carry) =>
        carry.FirstDayNumber == carry.LastDayNumber ? $"day {carry.FirstDayNumber}" : $"days {carry.FirstDayNumber}–{carry.LastDayNumber}";

    /// <summary>"Breakfast", or "Dinner: pizza in town" for a labelled one.</summary>
    private static string PlaceholderLineName(PlaceholderLine line) =>
        line.Label is null ? line.Slot.ToString() : $"{line.Slot}: {line.Label}";

    /// <summary>
    /// "~12 oz", "~12 oz (1 without a weight)" when some have no estimate, or "no weight" when none has one.
    /// </summary>
    private string PlaceholderLineWeight(PlaceholderLine line) =>
        line.WeightGrams == 0 && line.WithoutWeight > 0
            ? "no weight"
            : $"~{WeightTotal(line.WeightGrams, line.WithoutWeight)}";

    private static string ServingsText(decimal servings) => $"{ServingsInput.Format(servings)} serving{(servings == 1m ? "" : "s")}";

    /// <summary>A Resupply day's place, or its start when the place is blank; null when both are.</summary>
    private static string? ResupplyName(TripDay day) => day.ResupplyPlace ?? day.Start;

    /// <summary>Whether a Food Carry's card is open: those that are over start closed, the rest open, until tapped.</summary>
    private bool IsOpen(FoodCarry carry) => (carry.LastDate < _view!.Today) == _toggledCarries.Contains(carry.FirstDate);

    private void ToggleCarry(FoodCarry carry)
    {
        if (!_toggledCarries.Remove(carry.FirstDate))
        {
            _toggledCarries.Add(carry.FirstDate);
        }
    }

    private async Task ResetBoughtAsync(FoodCarry carry)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Reset shopping list", $"Untick all {carry.BoughtCount} bought for {FoodCarryName(carry)}?", yesText: "Reset", cancelText: "Cancel");
        if (confirmed == true)
        {
            await TryAsync(() => App.Trips.ResetBoughtAsync(TripId, carry.FirstDate));
        }
    }

    /// <summary>Opens Meals → Shopping scrolled to the Food Carry, opening its card if it was closed.</summary>
    private void OpenShopping(FoodCarry carry)
    {
        _tabName = MealsTab;
        _shopping = true;
        if (!IsOpen(carry))
        {
            ToggleCarry(carry);
        }

        _pendingDay = carry.FirstDate;
    }

    /// <summary>
    /// The Trip's stats: its length, then the route totals typed in on the Itinerary, then the calculated pack
    /// weights and food (frozen on a Completed Trip). A total with nothing filled in shows as a dash.
    /// </summary>
    private RenderFragment Stats() => __builder =>
    {
        var stats = _view!.Stats;
        <MudText Typo="Typo.h6" HtmlTag="p" Class="@(stats.AnySkipped ? "trip-length" : "mb-3 trip-length")">
            @Plural(stats.Days, "day") · @Plural(stats.Nights, "night")@(stats.AnySkipped ? " hiked" : "")
        </MudText>
        @if (stats.AnySkipped)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3 trip-length-planned">
                (@stats.PlannedDays planned)
            </MudText>
        }

        <MudPaper Class="pa-3 mb-4 route-stats">
            <MudText Typo="Typo.subtitle2" HtmlTag="h2">Route</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Totals of what's typed in on the Itinerary.</MudText>
            @StatLine(("Planned distance", "stat-planned", Recorded(stats.PlannedDistanceMetres, m => UnitFormat.Distance(m, _unitSystem))))
            @StatLine(("Actual distance", "stat-actual", Recorded(stats.ActualDistanceMetres, m => UnitFormat.Distance(m, _unitSystem))))
            @StatLine(("Elevation gain", "stat-gain", Recorded(stats.ElevationGainMetres, m => UnitFormat.Elevation(m, _unitSystem))))
            <div class="d-flex justify-space-between py-1 pick-row expected-distance-row" role="button" tabindex="0"
                 aria-label="Set expected distance" @onclick="SetExpectedDistanceAsync">
                <MudText Typo="Typo.body2">Expected distance</MudText>
                <MudText Typo="Typo.body2" Class="text-nowrap stat-expected">
                    @(_view.Trip.ExpectedDistanceMetres is { } expected ? UnitFormat.WholeDistance(expected, _unitSystem) : "None · tap to add")
                </MudText>
            </div>
            @Progress(stats, "mt-2")
        </MudPaper>

        <MudPaper Class="pa-3 mb-4 weight-stats">
            <MudText Typo="Typo.subtitle2" HtmlTag="h2">Pack weight</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                @(Completed ? "Frozen when the Trip was Completed." : "From the Packing List and each Gear Item's current weight.")
            </MudText>
            @StatLine(("Starting Pack Weight", "stat-starting", UnitFormat.Weight(stats.StartingPackGrams, _unitSystem)))
            @StatLine(("Base Weight", "stat-base", UnitFormat.Weight(stats.BaseGrams, _unitSystem)))
        </MudPaper>

        <MudPaper Class="pa-3 mb-4 food-stats">
            <MudText Typo="Typo.subtitle2" HtmlTag="h2">Food</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                @(Completed ? "Frozen when the Trip was Completed." : "From the Meal Plan and each Meal's and Food Item's current values.")
            </MudText>
            @StatLine(("Calories per day", "stat-calories-per-day", stats.CaloriesPerDay is { } perDay ? NutritionInput.Calories(Math.Round(perDay, 0, MidpointRounding.AwayFromZero)) : "—"))
            @StatLine(("Food cost", "stat-food-cost", stats.FoodCost is { } cost ? PriceInput.Format(cost) : "—"))
            @if (stats.LongestFoodCarry is { } longest)
            {
                <MudText Typo="Typo.body2" Class="mt-2 stat-resupplies">
                    @longest.Resupplies @(longest.Resupplies == 1 ? "resupply" : "resupplies") · longest Food Carry @Plural(longest.Days, "day") (@UnitFormat.Weight(longest.FoodGrams, _unitSystem))
                </MudText>
            }
            @if (stats.Eaten is { } eaten)
            {
                <MudText Typo="Typo.body2" Class="mt-2 stat-eaten">
                    @NutritionInput.Eaten(eaten.EatenCalories, eaten.PlannedCalories) planned@(eaten.Percent is { } percent ? $" ({percent}%)" : "")
                    · @NutritionInput.Calories(Math.Round(eaten.CaloriesPerDay, 0, MidpointRounding.AwayFromZero))/day eaten
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                    @(Completed ? "Over every day of the Trip." : "Over the days up to today.")
                </MudText>
            }
        </MudPaper>
    };

    private static RenderFragment StatLine((string Label, string Class, string Value) line) => __builder =>
    {
        <div class="d-flex justify-space-between py-1">
            <MudText Typo="Typo.body2">@line.Label</MudText>
            <MudText Typo="Typo.body2" Class="@($"text-nowrap {line.Class}")">@line.Value</MudText>
        </div>
    };

    private static string Recorded(decimal? metres, Func<decimal, string> format) => metres is { } m ? format(m) : "—";

    private static string Plural(int count, string noun) => $"{count} {noun}{(count == 1 ? "" : "s")}";

    /// <summary>"Start → End", or whichever of the two is filled in; null when neither is.</summary>
    private static string? RouteLine(TripDay day) => (day.Start, day.End) switch
    {
        (null, null) => null,
        ({ } start, null) => $"From {start}",
        (null, { } end) => $"To {end}",
        var (start, end) => $"{start} → {end}",
    };

    /// <summary>Such as "Planned 8.5 mi · Actual 9.0 mi · Gain 2,349 ft", leaving out what's empty.</summary>
    private string? FiguresLine(TripDay day)
    {
        var figures = new List<string>();
        if (day.PlannedDistanceMetres is { } planned)
        {
            figures.Add($"Planned {UnitFormat.Distance(planned, _unitSystem)}");
        }

        if (day.ActualDistanceMetres is { } actual)
        {
            figures.Add($"Actual {UnitFormat.Distance(actual, _unitSystem)}");
        }

        if (day.ElevationGainMetres is { } gain)
        {
            figures.Add($"Gain {UnitFormat.Elevation(gain, _unitSystem)}");
        }

        return figures.Count == 0 ? null : string.Join(" · ", figures);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_opened != (TripId, Tab, Day))
        {
            _opened = (TripId, Tab, Day);
            _tabName = Tab?.ToLowerInvariant();
            _pendingDay = DateOnly.TryParseExact(Day, "yyyy-MM-dd", out var date) ? date : null;
        }

        _unitSystem = (await App.Settings.GetAsync()).UnitSystem;
        await LoadAsync();
        _loaded = true;
    }

    /// <summary>Once the Trip is drawn, opens or scrolls to the day the address named.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingDay is not { } date || _view is null)
        {
            return;
        }

        var index = _view.Trip.Days.ToList().FindIndex(day => day.Date == date);
        if (index < 0 || (CurrentTab != ItineraryTab && CurrentTab != MealsTab))
        {
            _pendingDay = null;
        }
        else if (CurrentTab == ItineraryTab)
        {
            _pendingDay = null;
            await EditDayAsync(_view.Trip.Days[index], index + 1);
            StateHasChanged();
        }
        else
        {
            // The Meals tab may take another render to draw its days; try a few times, then give up.
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/scrollTo.js");
            var card = _shopping ? "food-carry" : "meal-plan-day";
            if (await module.InvokeAsync<bool>("scrollTo", $".{card}[data-date=\"{date:yyyy-MM-dd}\"]") || ++_scrollTries > 5)
            {
                _pendingDay = null;
                _scrollTries = 0;
            }
            else
            {
                StateHasChanged();
            }
        }
    }

    /// <summary>Loads the Trip, and puts today's stored actual distance and notes back in the Today tab's fields.</summary>
    private async Task LoadAsync()
    {
        _view = await App.Trips.GetTripAsync(TripId);
        _actualText = RouteInput.DistanceText(_view?.TodayDay?.ActualDistanceMetres, _unitSystem);
        _notesText = _view?.TodayDay?.JournalNotes;
    }

    private async Task EditDayAsync(TripDay day, int dayNumber)
    {
        var parameters = new DialogParameters<TripDayDialog>
        {
            { d => d.TripId, TripId },
            { d => d.Day, day },
            { d => d.UnitSystem, _unitSystem },
            { d => d.CanSkip, _view!.HasStarted },
            { d => d.IsFirstDay, dayNumber == 1 },
            { d => d.Locked, Completed },
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<TripDayDialog>($"Day {dayNumber} · {TripDates.Day(day.Date)}", parameters, options);
        await dialog.Result;
        await LoadAsync();
    }

    private async Task AddToSlotAsync(DayMealPlan dayPlan, MealSlot slot)
    {
        var parameters = new DialogParameters<AddToSlotDialog>
        {
            { d => d.TripId, TripId },
            { d => d.Date, dayPlan.Day.Date },
            { d => d.Slot, slot },
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<AddToSlotDialog>($"Day {dayPlan.DayNumber} · {slot}", parameters, options);
        await dialog.Result;
        await LoadAsync();
    }

    private async Task CopyMealPlanAsync()
    {
        var parameters = new DialogParameters<CopyMealPlanDialog> { { d => d.TripId, TripId } };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<CopyMealPlanDialog>("Copy a Meal Plan", parameters, options);
        await dialog.Result;
        await LoadAsync();
    }

    /// <summary>Opens a slot entry's dialog; for a Placeholder, "Replace with…" there opens the Meal and food picker.</summary>
    private async Task EditSlotEntryAsync(DayMealPlan dayPlan, SlotEntryView entryView, string name)
    {
        var parameters = new DialogParameters<SlotEntryDialog>
        {
            { d => d.TripId, TripId },
            { d => d.Date, dayPlan.Day.Date },
            { d => d.Entry, entryView.Entry },
            { d => d.UnitSystem, _unitSystem },
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<SlotEntryDialog>(name, parameters, options);
        if (await dialog.Result is { Canceled: false, Data: SlotEntryDialog.ReplaceResult })
        {
            await ReplacePlaceholderAsync(dayPlan, entryView, name);
            return;
        }

        await LoadAsync();
    }

