@page "/food/retired"
@inject AppCore App
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Retired food</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Retired food</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Food you no longer use. It stays on anything that used it, but is hidden from your food and pickers.
</MudText>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudText Class="mud-text-secondary">No retired food.</MudText>
}
else
{
    <MudPaper>
        @foreach (var item in _items)
        {
            <div class="d-flex align-center pl-3 pr-1 py-2 gap-2">
                <div class="flex-grow-1">
                    <MudText>@item.Name</MudText>
                </div>
                <MudButton Size="Size.Small" OnClick="() => UnretireAsync(item)">Un-retire</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               aria-label="@($"Delete {item.Name}")" OnClick="() => DeleteAsync(item)" />
            </div>
            <MudDivider />
        }
    </MudPaper>
}

@code {
    private IReadOnlyList<FoodItem>? _items;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _items = await App.Food.ListRetiredFoodItemsAsync();

    private async Task UnretireAsync(FoodItem item)
    {
        await App.Food.UnretireFoodItemAsync(item.Id);
        Snackbar.Add($"{item.Name} is back in your food.", Severity.Success);
        await LoadAsync();
    }

    private async Task DeleteAsync(FoodItem item)
    {
        // A Retired Food Item is never offered Retire, so confirming always means delete.
        var plan = await App.Food.PlanFoodItemDeletionAsync(item.Id);
        if (await DialogService.ConfirmDeletionAsync(plan))
        {
            await App.Food.DeleteFoodItemAsync(item.Id);
            await LoadAsync();
        }
    }
}
