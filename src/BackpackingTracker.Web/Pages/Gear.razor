@page "/"
@inject AppCore App
@inject IDialogService DialogService

<PageTitle>Gear</PageTitle>
<RefreshAfterSync OnChangesArrived="OnInitializedAsync" />

<MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Gear</MudText>

<div class="d-flex align-end gap-3">
    <MudTextField T="string" Value="_searchText" ValueChanged="SearchAsync" Label="Search gear" Immediate="true"
                  DebounceInterval="200" Clearable="true" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Class="flex-grow-1 gear-search" />
    <MudSelect T="string" Value="_filterGearType" ValueChanged="FilterByGearTypeAsync" Label="Gear Type"
               Class="gear-type-filter" Clearable="true" Placeholder="All">
        @foreach (var gearType in _gearTypes)
        {
            <MudSelectItem Value="gearType">@gearType</MudSelectItem>
        }
    </MudSelect>
</div>

<div class="d-flex justify-end mt-1">
    <MudButton Href="gear/import" Variant="Variant.Text" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.UploadFile">Import</MudButton>
    <MudButton Href="gear/retired" Variant="Variant.Text" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Inventory2">Retired</MudButton>
</div>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudText Class="mud-text-secondary mt-4">
        @(Filter.IsEmpty ? "No gear yet. Tap + to add your first Gear Item." : "No Gear Items match.")
    </MudText>
}
else
{
    <MudPaper Class="mt-2">
        @foreach (var item in _items)
        {
            <div class="d-flex align-center pa-3 gap-3 gear-row" role="button" tabindex="0"
                 aria-label="@($"Edit {item.Name}")" @onclick="() => EditAsync(item)">
                <div class="flex-grow-1">
                    <MudText>@item.Name</MudText>
                    @if (item.GearType.Length > 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary gear-type">@item.GearType</MudText>
                    }
                    @if (item.Tags.Count > 0)
                    {
                        <div class="gear-tags">
                            @foreach (var tag in item.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                            }
                        </div>
                    }
                </div>
                <div class="text-right">
                    <MudText Class="text-nowrap gear-weight">@UnitFormat.Weight(item.WeightGrams, _unitSystem)</MudText>
                    @if (item.Price is { } price)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary text-nowrap">@PriceInput.Format(price)</MudText>
                    }
                </div>
            </div>
            <MudDivider />
        }
    </MudPaper>
}

<MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" Class="add-fab" aria-label="Add Gear Item"
        OnClick="AddAsync" />

@code {
    private UnitSystem _unitSystem;
    private IReadOnlyList<string> _gearTypes = [];
    private IReadOnlyList<GearItem>? _items;
    private string? _searchText;
    private string? _filterGearType;

    private GearFilter Filter => new(_searchText, _filterGearType);

    protected override async Task OnInitializedAsync()
    {
        _unitSystem = (await App.Settings.GetAsync()).UnitSystem;
        await LoadGearAsync();
    }

    private async Task LoadGearAsync()
    {
        _gearTypes = await App.Gear.ListGearTypesAsync();
        _items = await App.Gear.ListGearItemsAsync(Filter);
    }

    private async Task SearchAsync(string? searchText)
    {
        _searchText = searchText;
        await LoadGearAsync();
    }

    private async Task FilterByGearTypeAsync(string? gearType)
    {
        _filterGearType = gearType;
        await LoadGearAsync();
    }

    private Task AddAsync() => ShowGearItemDialogAsync("Add Gear Item", item: null);

    private Task EditAsync(GearItem item) => ShowGearItemDialogAsync("Edit Gear Item", item);

    private async Task ShowGearItemDialogAsync(string title, GearItem? item)
    {
        var parameters = new DialogParameters<GearItemDialog>
        {
            { d => d.GearItem, item },
            { d => d.UnitSystem, _unitSystem },
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<GearItemDialog>(title, parameters, options);
        await dialog.Result;
        await LoadGearAsync();
    }
}
