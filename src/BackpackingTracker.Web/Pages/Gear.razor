@page "/"
@inject AppCore App
@inject ISnackbar Snackbar

<PageTitle>Gear</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Gear</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudForm @ref="_form">
        <MudTextField @bind-Value="_name" Label="Name" Required="true" RequiredError="Give the gear item a name" />
        <MudTextField @bind-Value="_brandModel" Label="Brand / model" />
        <div class="d-flex gap-3">
            <MudTextField @bind-Value="_weightText" Label="Weight" InputMode="@(InputMode.@decimal)"
                          Validation="@(new Func<string?, string?>(ValidateWeight))" Class="flex-grow-1" />
            <MudSelect T="WeightUnit" @bind-Value="_weightUnit" Label="Unit" Class="weight-unit">
                @foreach (var unit in Enum.GetValues<WeightUnit>())
                {
                    <MudSelectItem Value="unit">@WeightInput.Label(unit)</MudSelectItem>
                }
            </MudSelect>
        </div>
        <MudSelect T="string" @bind-Value="_categoryId" Label="Category" Required="true" Class="category-select"
                   RequiredError="Choose a Category">
            @foreach (var category in _categories)
            {
                <MudSelectItem Value="category.Id">@category.Name</MudSelectItem>
            }
        </MudSelect>
        <TagEditor @ref="_tagEditor" @bind-Tags="_tags" TagsInUse="_tagsInUse" />
        <MudButton OnClick="AddAsync" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Add" Disabled="_saving">Add</MudButton>
    </MudForm>
</MudPaper>

<div class="d-flex align-end gap-3">
    <MudTextField T="string" Value="_searchText" ValueChanged="SearchAsync" Label="Search gear" Immediate="true"
                  DebounceInterval="200" Clearable="true" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Class="flex-grow-1 gear-search" />
    <MudSelect T="string" Value="_filterCategoryId" ValueChanged="FilterByCategoryAsync" Label="Category"
               Class="category-filter" Clearable="true" Placeholder="All">
        @foreach (var category in _categories)
        {
            <MudSelectItem Value="category.Id">@category.Name</MudSelectItem>
        }
    </MudSelect>
</div>

<div class="d-flex justify-end mt-1">
    <MudButton Href="categories" Variant="Variant.Text" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Category">Edit Categories</MudButton>
</div>

@if (_sections is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_sections.Count == 0)
{
    <MudText Class="mud-text-secondary">
        @(!Filter.IsEmpty ? "No Gear Items match." : "No gear yet. Add your first Gear Item above.")
    </MudText>
}
else
{
    @foreach (var categorySection in _sections)
    {
        <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="mt-4 mb-1 px-1">@categorySection.Category.Name</MudText>
        <MudPaper>
            @foreach (var item in categorySection.GearItems)
            {
                <div class="d-flex align-center pa-3 gap-3">
                    <div class="flex-grow-1">
                        <MudText>@item.Name</MudText>
                        @if (!string.IsNullOrEmpty(item.BrandModel))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@item.BrandModel</MudText>
                        }
                        @if (item.Tags.Count > 0)
                        {
                            <div class="gear-tags">
                                @foreach (var tag in item.Tags)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                                }
                            </div>
                        }
                    </div>
                    <MudText Class="text-nowrap">@UnitFormat.Weight(item.WeightGrams, _unitSystem)</MudText>
                </div>
                <MudDivider />
            }
        </MudPaper>
    }
}

@code {
    private MudForm _form = default!;
    // MudForm.ResetAsync sets these back to null.
    private string? _name;
    private string? _brandModel;
    private string? _weightText;
    private string? _categoryId;
    private TagEditor _tagEditor = default!;
    private IReadOnlyList<string> _tags = [];
    private WeightUnit _weightUnit;
    private UnitSystem _unitSystem;
    private bool _saving;
    private IReadOnlyList<Category> _categories = [];
    private IReadOnlyList<string> _tagsInUse = [];
    private IReadOnlyList<CategorySection>? _sections;
    private string? _searchText;
    private string? _filterCategoryId;

    private GearFilter Filter => new(_searchText, _filterCategoryId);

    protected override async Task OnInitializedAsync()
    {
        _unitSystem = (await App.Settings.GetAsync()).UnitSystem;
        _weightUnit = WeightInput.DefaultUnit(_unitSystem);
        _categories = await App.Gear.ListCategoriesAsync();
        _tagsInUse = await App.Gear.ListTagsAsync();
        await LoadGearAsync();
    }

    private async Task LoadGearAsync()
    {
        _sections = await App.Gear.ListGearItemsByCategoryAsync(Filter);
    }

    private async Task SearchAsync(string? searchText)
    {
        _searchText = searchText;
        await LoadGearAsync();
    }

    private async Task FilterByCategoryAsync(string? categoryId)
    {
        _filterCategoryId = categoryId;
        await LoadGearAsync();
    }

    private string? ValidateWeight(string? text) => WeightInput.Parse(text, _weightUnit).Error;

    private async Task AddAsync()
    {
        await _form.ValidateAsync();
        var weight = WeightInput.Parse(_weightText, _weightUnit);
        if (!_form.IsValid || weight.Grams is null)
        {
            return;
        }

        _saving = true;
        try
        {
            var categoryId = _categoryId ?? "";
            await App.Gear.AddGearItemAsync(
                new GearItemDetails(_name ?? "", _brandModel, weight.Grams.Value, categoryId, _tagEditor.TagsIncludingTyped()));
            await _form.ResetAsync();

            // Keep the unit and Category, so adding several items in a row is quick.
            _weightUnit = WeightInput.DefaultUnit(_unitSystem);
            _categoryId = categoryId;
            _tags = [];
            _tagsInUse = await App.Gear.ListTagsAsync();
            await LoadGearAsync();
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _saving = false;
        }
    }
}
