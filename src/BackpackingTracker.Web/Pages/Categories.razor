@page "/categories"
@inject AppCore App
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Default Categories</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Default Categories</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Each new Gear List starts with a copy of these. Changing them doesn't change lists you already have;
    edit a list's own Categories on the list.
</MudText>

<MudPaper Class="pa-4 mb-4">
    <div class="d-flex align-center gap-3">
        <MudTextField @bind-Value="_newName" Label="New Category" Class="flex-grow-1" Immediate="true"
                      OnKeyUp="OnNewNameKeyUp" />
        <MudButton OnClick="AddAsync" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">Add</MudButton>
    </div>
</MudPaper>

@if (_categories is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper>
        @for (var position = 0; position < _categories.Count; position++)
        {
            var category = _categories[position];
            var index = position;
            <div class="d-flex align-center pl-3 pr-1 py-1">
                <MudText Class="flex-grow-1">@category.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="index == 0"
                               aria-label="@($"Move {category.Name} up")" OnClick="() => MoveAsync(category, index - 1)" />
                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                               Disabled="index == _categories.Count - 1"
                               aria-label="@($"Move {category.Name} down")" OnClick="() => MoveAsync(category, index + 1)" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               aria-label="@($"Rename {category.Name}")" OnClick="() => RenameAsync(category)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               aria-label="@($"Remove {category.Name}")" OnClick="() => RemoveAsync(category)" />
            </div>
            <MudDivider />
        }
    </MudPaper>
}

@code {
    private string? _newName;
    private IReadOnlyList<DefaultCategory>? _categories;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _categories = await App.Gear.ListDefaultCategoriesAsync();

    private async Task OnNewNameKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddAsync();
        }
    }

    private async Task AddAsync()
    {
        if (await TryAsync(() => App.Gear.AddDefaultCategoryAsync(_newName ?? "")))
        {
            _newName = null;
        }
    }

    private Task MoveAsync(DefaultCategory category, int newPosition) =>
        TryAsync(() => App.Gear.MoveDefaultCategoryAsync(category.Id, newPosition));

    private async Task RenameAsync(DefaultCategory category)
    {
        var parameters = new DialogParameters<NameDialog> { { d => d.CurrentName, category.Name } };
        var dialog = await DialogService.ShowAsync<NameDialog>("Rename Category", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string newName })
        {
            await TryAsync(() => App.Gear.RenameDefaultCategoryAsync(category.Id, newName));
        }
    }

    private async Task RemoveAsync(DefaultCategory category)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove Category", $"Remove {category.Name}?", yesText: "Remove", cancelText: "Cancel");
        if (confirmed == true)
        {
            await TryAsync(() => App.Gear.RemoveDefaultCategoryAsync(category.Id));
        }
    }

    /// <summary>Runs a change, shows the reason if the core refuses it, and reloads the list.</summary>
    private async Task<bool> TryAsync(Func<Task> change)
    {
        try
        {
            await change();
            return true;
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            return false;
        }
        finally
        {
            await LoadAsync();
        }
    }
}
