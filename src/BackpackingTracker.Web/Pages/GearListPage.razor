@page "/lists/{GearListId}"
@using BackpackingTracker.Core.Lists
@inject AppCore App
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@(_view?.GearList.Name ?? "Gear List")</PageTitle>

<MudButton Href="lists" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack"
           Class="mb-1 ml-n2">Gear Lists</MudButton>

@if (_loaded && _view is null)
{
    <MudText Typo="Typo.h5" HtmlTag="h1">Gear List not found</MudText>
    <MudText Class="mud-text-secondary">It may have been deleted.</MudText>
}
else if (_view is not null)
{
    <MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">@_view.GearList.Name</MudText>

    <MudPaper Class="pa-3 mb-4 pack-totals">
        <div class="d-flex justify-space-between">
            <MudText Typo="Typo.subtitle1"><b>Starting Pack Weight</b></MudText>
            <MudText Typo="Typo.subtitle1" Class="total-starting"><b>@Weight(_view.Weight.StartingPackGrams)</b></MudText>
        </div>
        <div class="d-flex justify-space-between">
            <MudText Typo="Typo.body2">Base Weight</MudText>
            <MudText Typo="Typo.body2" Class="total-base">@Weight(_view.Weight.BaseGrams)</MudText>
        </div>
        <div class="d-flex justify-space-between">
            <MudText Typo="Typo.body2">Consumable Weight</MudText>
            <MudText Typo="Typo.body2" Class="total-consumable">@Weight(_view.Weight.ConsumableGrams)</MudText>
        </div>
        <div class="d-flex justify-space-between">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Worn Weight (not in the pack)</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary total-worn">@Weight(_view.Weight.WornGrams)</MudText>
        </div>
    </MudPaper>

    @if (_view.Weight.ByCategory.Count > 0)
    {
        <MudPaper Class="pa-3 mb-4 category-breakdown">
            <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="mb-2">Where the pack weight goes</MudText>
            @foreach (var line in _view.Weight.ByCategory)
            {
                <div class="breakdown-line">
                    <div class="d-flex justify-space-between gap-2">
                        <MudText Typo="Typo.body2" Class="breakdown-name">@line.Category.Name</MudText>
                        <MudText Typo="Typo.body2" Class="text-nowrap">
                            @Weight(line.Grams) <span class="breakdown-share">@UnitFormat.Share(line.Share)</span>
                        </MudText>
                    </div>
                    <MudProgressLinear Value="@((double)(line.Share * 100))" Color="Color.Primary" Size="Size.Small" Rounded="true" />
                </div>
            }
        </MudPaper>
    }

    @foreach (var categorySection in _view.Sections)
    {
        var category = categorySection.Category;
        var isOnList = categorySection.IsOnList;
        var position = categorySection.Position;
        <div class="d-flex align-center mt-4 mb-1 pl-1 category-heading" data-category="@category.Name">
            <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="flex-grow-1">@category.Name</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary text-nowrap category-subtotal">
                @(categorySection.Entries.Count == 0 ? "Empty" : Weight(categorySection.SubtotalGrams))
            </MudText>
            @if (isOnList)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="@($"Add gear to {category.Name}")"
                               OnClick="() => AddGearAsync(category.Id)" />
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="@($"Options for {category.Name}")">
                    <MudMenuItem OnClick="() => RenameCategoryAsync(category)">Rename</MudMenuItem>
                    <MudMenuItem OnClick="() => MoveCategoryAsync(category, position - 1)" Disabled="position == 0">Move up</MudMenuItem>
                    <MudMenuItem OnClick="() => MoveCategoryAsync(category, position + 1)"
                                 Disabled="position == _view.GearList.Categories.Count - 1">Move down</MudMenuItem>
                    <MudMenuItem OnClick="() => RemoveCategoryAsync(category)">Remove</MudMenuItem>
                </MudMenu>
            }
        </div>
        @if (categorySection.Entries.Count > 0)
        {
        <MudPaper>
            @foreach (var entryView in categorySection.Entries)
            {
                var entry = entryView.Entry;
                var entryName = entryView.GearItem?.Name ?? "Deleted Gear Item";
                <div class="pa-3 list-entry">
                    <div class="d-flex align-center gap-2">
                        <div class="flex-grow-1">
                            @if (entryView.GearItem is { } item)
                            {
                                <MudText>@item.Name@(item.Retired ? " (Retired)" : "")</MudText>
                                @if (item.GearType.Length > 0)
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@item.GearType</MudText>
                                }
                            }
                            else
                            {
                                <MudText Class="mud-text-secondary">Deleted Gear Item</MudText>
                            }
                        </div>
                        <MudText Class="text-nowrap entry-weight">@Weight(entryView.EntryWeightGrams)</MudText>
                    </div>
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Disabled="entry.Quantity <= 1"
                                       aria-label="Fewer" OnClick="() => UpdateAsync(entry, entry.Quantity - 1, entry.CarryMode)" />
                        <MudText Class="entry-quantity">@entry.Quantity</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                       aria-label="More" OnClick="() => UpdateAsync(entry, entry.Quantity + 1, entry.CarryMode)" />
                        <MudSelect T="CarryMode" Value="entry.CarryMode" Dense="true" Class="carry-mode ml-2"
                                   ValueChanged="mode => UpdateAsync(entry, entry.Quantity, mode)">
                            @foreach (var mode in Enum.GetValues<CarryMode>())
                            {
                                <MudSelectItem Value="mode">@mode</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSpacer />
                        <MudMenu Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" Dense="true"
                                 AriaLabel="@($"Move {entryName} to another Category")">
                            @foreach (var target in _view.GearList.Categories.Where(c => c.Id != entry.CategoryId))
                            {
                                <MudMenuItem OnClick="() => MoveEntryAsync(entry, target)">@target.Name</MudMenuItem>
                            }
                        </MudMenu>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       aria-label="Remove from list" OnClick="() => RemoveAsync(entry)" />
                    </div>
                </div>
                <MudDivider />
            }
        </MudPaper>
        }
    }

    <div class="d-flex justify-center mt-4">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="AddCategoryAsync">
            Add Category
        </MudButton>
    </div>

    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="add-fab" aria-label="Add gear to list"
            OnClick="() => AddGearAsync(null)" />
}

@code {
    [Parameter]
    public string GearListId { get; set; } = "";

    private UnitSystem _unitSystem;
    private GearListView? _view;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        _unitSystem = (await App.Settings.GetAsync()).UnitSystem;
        await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync() => _view = await App.Lists.GetGearListAsync(GearListId);

    private string Weight(decimal grams) => UnitFormat.Weight(grams, _unitSystem);

    private Task UpdateAsync(ListEntry entry, int quantity, CarryMode carryMode) =>
        TryAsync(() => App.Lists.UpdateEntryAsync(GearListId, entry.Id, quantity, carryMode));

    private Task MoveEntryAsync(ListEntry entry, Category target) =>
        TryAsync(() => App.Lists.MoveEntryAsync(GearListId, entry.Id, target.Id));

    private Task RemoveAsync(ListEntry entry) => TryAsync(() => App.Lists.RemoveEntryAsync(GearListId, entry.Id));

    /// <summary>Opens the picker; from a Category's + it starts on that Category, otherwise on the first.</summary>
    private async Task AddGearAsync(string? categoryId)
    {
        var parameters = new DialogParameters<AddGearDialog>
        {
            { d => d.GearListId, GearListId },
            { d => d.Categories, _view!.GearList.Categories },
            { d => d.CategoryId, categoryId ?? _view.GearList.Categories[0].Id },
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<AddGearDialog>("Add gear", parameters, options);
        await dialog.Result;
        await LoadAsync();
    }

    private async Task AddCategoryAsync()
    {
        var name = await AskForNameAsync("New Category", "", "Add");
        if (name is not null)
        {
            await TryAsync(() => App.Lists.AddCategoryAsync(GearListId, name));
        }
    }

    private async Task RenameCategoryAsync(Category category)
    {
        var name = await AskForNameAsync("Rename Category", category.Name, "Save");
        if (name is not null)
        {
            await TryAsync(() => App.Lists.RenameCategoryAsync(GearListId, category.Id, name));
        }
    }

    private Task MoveCategoryAsync(Category category, int newPosition) =>
        TryAsync(() => App.Lists.MoveCategoryAsync(GearListId, category.Id, newPosition));

    private async Task RemoveCategoryAsync(Category category)
    {
        var plan = await App.Lists.PlanCategoryRemovalAsync(GearListId, category.Id);
        if (!plan.NeedsMoveTarget)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                "Remove Category", plan.Message, yesText: "Remove", cancelText: "Cancel");
            if (confirmed == true)
            {
                await TryAsync(() => App.Lists.RemoveCategoryAsync(GearListId, category.Id));
            }

            return;
        }

        var parameters = new DialogParameters<RemoveCategoryDialog> { { d => d.Plan, plan } };
        var dialog = await DialogService.ShowAsync<RemoveCategoryDialog>("Remove Category", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string targetId })
        {
            await TryAsync(() => App.Lists.RemoveCategoryAsync(GearListId, category.Id, moveEntriesToCategoryId: targetId));
        }
    }

    private async Task<string?> AskForNameAsync(string title, string currentName, string saveText)
    {
        var parameters = new DialogParameters<NameDialog> { { d => d.CurrentName, currentName }, { d => d.SaveText, saveText } };
        var dialog = await DialogService.ShowAsync<NameDialog>(title, parameters);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string name } ? name : null;
    }

    /// <summary>Runs a change, shows the reason if the core refuses it, and reloads the list.</summary>
    private async Task TryAsync(Func<Task> change)
    {
        try
        {
            await change();
        }
        catch (RuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }

        await LoadAsync();
    }
}
